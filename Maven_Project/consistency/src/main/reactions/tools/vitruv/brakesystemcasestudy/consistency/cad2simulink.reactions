import java.io.File;
import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality
import java.util.Arrays

import edu.kit.ipd.sdq.metamodels.cad.StringParameter;
import edu.kit.ipd.sdq.metamodels.cad.NumericParameter;
import edu.kit.ipd.sdq.metamodels.cad.BooleanParameter;

import "http://vitruv.tools/methodologisttemplate/simulink" as simulink
import "http://www.example.org/cad" as cad

reactions: cad2simulink
in reaction to changes in cad
execute actions in simulink



// Insertion Reactions

reaction CAD_ModelInsertedAsRoot {
    after element cad::CAD_Model inserted as root
    call createAndRegisterRoot(newValue)
}


routine createAndRegisterRoot(cad::CAD_Model model) {
    match {
        require absence of simulink::SimulinkModel corresponding to model
    }
    create {
        val mSimulink = new simulink::SimulinkModel
    }
    update {
        mSimulink.name = model.name
        persistProjectRelative(model, mSimulink, new File("").toString() + "example.simulink")
        addCorrespondenceBetween(model, mSimulink)
    }
}


reaction NameSpaceInserted {
    after element cad::Namespace inserted in cad::CAD_Model[namespaces]
    call createAndRegisterNamespace(newValue)
}
routine createAndRegisterNamespace(cad::Namespace namespace) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to namespace.eContainer()
        require absence of simulink::Block corresponding to namespace
    }
    update {
        val componentType = userInteractor.singleSelectionDialogBuilder.message(
    			"What Simulink component do you want to add to be correspondent to this namespace?").choices(
    			Arrays.asList("SimulinkBlock","SimulinkSubsystem")).windowModality(WindowModality.MODAL).
    			startInteraction
    		switch (componentType) {
    			case 0:
    				createSimulinkBlock(namespace, mSimulink)
    			case 1:
    				createSimulinkSubsystem(namespace, mSimulink)
                default:
                    return // Do nothing
    		}
    }
}


routine createSimulinkBlock(cad::Namespace namespace, simulink::SimulinkModel mSimulink) {
    create {
        val mBlock = new simulink::Block
    }
    update {
        mBlock.name = namespace.name
        mSimulink.contains += mBlock
        addCorrespondenceBetween(namespace, mBlock)
    }
}


routine createSimulinkSubsystem(cad::Namespace namespace, simulink::SimulinkModel mSimulink) {
    create {
        val mSubsystem = new simulink::SubSystem
    }
    update {
        mSubsystem.name = namespace.name
        mSimulink.contains += mSubsystem
        addCorrespondenceBetween(namespace, mSubsystem)
    }
}


reaction StringParameterInserted {
    after element cad::StringParameter inserted in cad::Namespace[parameters]
    call createAndRegisterStringParameter(newValue)
}


routine createAndRegisterStringParameter(cad::StringParameter parameter) {
    match {
        val mBlock = retrieve simulink::Block corresponding to parameter.eContainer()
        require absence of simulink::Parameter corresponding to parameter
    }
    create {
        val mParameter = new simulink::Parameter
    }
    update {
        mParameter.name = parameter.name
        mParameter.value = parameter.value
        mParameter.type = "string"
        mBlock.parameters += mParameter
        addCorrespondenceBetween(parameter, mParameter)
    }
}



reaction NumericParameterInserted {
    after element cad::NumericParameter inserted in cad::Namespace[parameters]
    call createAndRegisterNumericParameter(newValue)
}


routine createAndRegisterNumericParameter(cad::NumericParameter parameter) {
    match {
        val mBlock = retrieve simulink::Block corresponding to parameter.eContainer()
        require absence of simulink::Parameter corresponding to parameter
    }
    create {
        val mParameter = new simulink::Parameter
    }
    update {
        mParameter.name = parameter.name
        mParameter.value = parameter.value.toString()
        val parametertype = userInteractor.singleSelectionDialogBuilder.message(
            "What Simulink Parametertype do you want to add to be correspondent to this Numeric CAD Parameter?").choices(
            Arrays.asList("double","single","half","uint8","int8","uint16","int16","uint32","int32","uint64","int64")).windowModality(WindowModality.MODAL).
            startInteraction
        switch (parametertype) {
            case 0:
                mParameter.type = "double"
            case 1:
                mParameter.type = "single"
            case 2:
                mParameter.type = "half"
            case 3:
                mParameter.type = "uint8"
            case 4:
                mParameter.type = "int8"
            case 5:
                mParameter.type = "uint16"
            case 6:
                mParameter.type = "int16"
            case 7:
                mParameter.type = "uint32"
            case 8:
                mParameter.type = "int32"
            case 9:
                mParameter.type = "uint64"
            case 10:
                mParameter.type = "int64"
            default:
                return // Do nothing
        }
        
        mBlock.parameters += mParameter
        addCorrespondenceBetween(parameter, mParameter)
    }
}


reaction BooleanParameterInserted {
    after element cad::BooleanParameter inserted in cad::Namespace[parameters]
    call createAndRegisterBooleanParameter(newValue)
}

routine createAndRegisterBooleanParameter(cad::BooleanParameter parameter) {
    match {
        val mBlock = retrieve simulink::Block corresponding to parameter.eContainer()
        require absence of simulink::Parameter corresponding to parameter
    }
    create {
        val mParameter = new simulink::Parameter
    }
    update {
        mParameter.name = parameter.name
        mParameter.value = parameter.value.toString()
        mParameter.type = "boolean"
        mBlock.parameters += mParameter
        addCorrespondenceBetween(parameter, mParameter)
    }
}


/// Deletion Reactions

reaction CAD_ParameterDeleted {
    after element cad::Parameter deleted
    call deleteCorrespondingSimulinkParameter(affectedEObject)
}

routine deleteCorrespondingSimulinkParameter(cad::Parameter parameter) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update{
        removeObject(mParameter)
        removeCorrespondenceBetween(parameter, mParameter)
    }
}

reaction NamespaceDeleted {
    after element cad::Namespace deleted
    call deleteCorrespondingSimulinkComponent(affectedEObject)
}

routine deleteCorrespondingSimulinkComponent(cad::Namespace namespace) {
    match {
        val mComponent = retrieve simulink::Block corresponding to namespace
    }
    update{
        removeObject(mComponent)
        removeCorrespondenceBetween(namespace, mComponent)
    }
}


// Update Reactions


reaction CAD_ModelNameChanged {
    after attribute replaced at cad::CAD_Model[name]
    call updateSimulinkModelName(affectedEObject, newValue)
}

routine updateSimulinkModelName(cad::CAD_Model model, String newName) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to model
    }
    update {
        mSimulink.name = newName
    }
}

reaction NamespaceNameChanged {
    after attribute replaced at cad::Namespace[name]
    call updateSimulinkComponentName(affectedEObject, newValue)
}

routine updateSimulinkComponentName(cad::Namespace namespace, String newName) {
    match {
        val mComponent = retrieve simulink::Block corresponding to namespace
    }
    update {
        mComponent.name = newName
    }
}

reaction StringParameterNameChanged {
    after attribute replaced at cad::StringParameter[name]
    call updateSimulinkStringParameterName(affectedEObject, newValue)
}

routine updateSimulinkStringParameterName(cad::StringParameter parameter, String newName) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update {
        mParameter.name = newName
    }
}




