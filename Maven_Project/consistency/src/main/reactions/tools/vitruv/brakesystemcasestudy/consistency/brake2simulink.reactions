import "http://vitruv.tools/methodologisttemplate/simulink" as simulink
import "http://www.example.org/brakesystem" as brakesystem

reactions: brakesystem2simulink
in reaction to changes in brakesystem
execute actions in simulink

//Insertion Reactions


reaction BrakesystemInsertedAsRoot {
 after element brakesystem::Brakesystem inserted as root
    call createAndRegisterRoot(newValue)
}


routine createAndRegisterRoot(brakesystem::Brakesystem repo) {
    match {
        require absence of simulink::SimulinkModel corresponding to repo
    }
    create {
        val mSimulink = new simulink::SimulinkModel
    }
    update {
        mSimulink.name = repo.instanceName
        persistProjectRelative(repo, mSimulink, new File("").toString() + "example.simulink")
        addCorrespondenceBetween(repo, mSimulink)
    }
}

// Reactions for Brake component Parameter Changes


reaction SpecificationTypeChanged {
    after attribute replaced at brakesystem::BrakeComponent[specificationType]
    call updateSpecificationType(affectedEObject)
}

reaction OEMNumberChanged {
    after attribute replaced at brakesystem::BrakeComponent[OEM_number]
    call updateOEMNumber(affectedEObject)
}

reaction FittingPositionChanged {
    after attribute replaced at brakesystem::BrakeComponent[fittingPosition]
    call updateFittingPosition(affectedEObject)
}

reaction IdChanged {
    after attribute replaced at brakesystem::BrakeComponent[id]
    call updateId(affectedEObject)
}


// Routines for Brake component parameter changes

routine updateSpecificationType(brakesystem::BrakeComponent comp) {
    match {
        val block = retrieve simulink::Block corresponding to comp
    }
     create {
        val parameter = new simulink::Parameter
    }
    
    update {
        var pSpecificationType = block.parameters.findFirst[p | p.name == "Specification Type"]
        if (pSpecificationType === null) {
            pSpecificationType = parameter
            pSpecificationType.name = "Specification Type"
            pSpecificationType.type = "string"
            block.parameters.add(pSpecificationType)
        }
        pSpecificationType.value = comp.specificationType
    }
}

routine updateOEMNumber(brakesystem::BrakeComponent comp) {
    match {
        val block = retrieve simulink::Block corresponding to comp
    }
    create {
        val parameter = new simulink::Parameter
    }
    update {
        var pOEM_Number = block.parameters.findFirst[p | p.name == "OEM Number"]
        if (pOEM_Number === null) {
            pOEM_Number = parameter
            pOEM_Number.name = "OEM Number"
            pOEM_Number.type = "string"
            block.parameters.add(pOEM_Number)
        }
        pOEM_Number.value = comp.OEM_number
    }
}


routine updateFittingPosition(brakesystem::BrakeComponent comp) {
    match {
        val block = retrieve simulink::Block corresponding to comp
    }
    create {
        val parameter = new simulink::Parameter
    }
    update {
        var pFittingPosition = block.parameters.findFirst[p | p.name == "Fitting Position"]
        if (pFittingPosition === null) {
            pFittingPosition = parameter
            pFittingPosition.name = "Fitting Position"
            pFittingPosition.type = "string"
            block.parameters.add(pFittingPosition)
        }
        pFittingPosition.value = comp.fittingPosition
    }
}

routine updateId(brakesystem::BrakeComponent comp) {
    match {
        val block = retrieve simulink::Block corresponding to comp
    }
    update {
        block.name = comp.id
    }
}







//Reaction or inserting a Brake Disk

reaction BrakeDiskInserted {
    after element brakesystem::BrakeDisk inserted in brakesystem::Brakesystem[BrakeComponents]
    call {
         createAndRegisterBrakeDisk(newValue)
         addBrakeDiskSpecificParameters(newValue)
        }
}


// Routine for creating a Simulink block and register it
routine createAndRegisterBrakeDisk(brakesystem::BrakeDisk disk) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to disk.eContainer()
        require absence of simulink::Block corresponding to disk
    }

create {
       // Create the Simulink block
        val diskBlock = new simulink::Block
    }
    update {
        diskBlock.name = disk.id
        // Add the block to the Simulink model
        mSimulink.contains += diskBlock
        // create correspondence for retrival
        addCorrespondenceBetween(disk, diskBlock)
    }

  }


// Routine for Add Brake Disk-Specific parameters
routine addBrakeDiskSpecificParameters(brakesystem::BrakeDisk disk) {
    match {
        // Retrieve the block corresponding to this Brake Disk
        val diskBlock = retrieve Simulink::Block corresponding to disk
    }
    create {
        // Add parameters specific to BrakeDisk
        val pSpecificationType = new simulink::Parameter
        val pOEM_Number = new simulink::Parameter
        val pFittingPosition = new simulink::Parameter
        val pDiameter = new simulink::Parameter
        val pCenteringDiameter = new simulink::Parameter
        val pRimHoleNumber = new simulink::Parameter
        val pHoleArrangementNumber = new simulink::Parameter
        val pBoltHoleCircle = new simulink::Parameter
        val pBrakeDiskThickness = new simulink::Parameter
        val pMinimumThickness = new simulink::Parameter
        val pVentilated = new simulink::Parameter
    }
  update {
   
       // Assign parameter to the block 
      
        
        // Common BrakeComponent parameters
        diskBlock.parameters.add(pSpecificationType)
        pSpecificationType.name = "Specification Type"
        pSpecificationType.type = "string"
        pSpecificationType.value = disk.specificationType
        
        diskBlock.parameters.add(pOEM_Number)
        pOEM_Number.name = "OEM Number"
        pOEM_Number.type = "string"
        pOEM_Number.value = disk.OEM_number
        
        diskBlock.parameters.add(pFittingPosition)
        pFittingPosition.name = "Fitting Position"
        pFittingPosition.type = "string"
        pFittingPosition.value = disk.fittingPosition
        
        // BrakeDisk-specific parameters
        diskBlock.parameters.add(pDiameter)
        pDiameter.name = "Diameter"
        pDiameter.type = "int32"
        pDiameter.value = disk.diameterInMM.toString()
        
        diskBlock.parameters.add(pCenteringDiameter)
        pCenteringDiameter.name = "Centering Diameter"
        pCenteringDiameter.type = "int32"
        pCenteringDiameter.value = disk.centeringDiameterInMM.toString()
        
        diskBlock.parameters.add(pRimHoleNumber)
        pRimHoleNumber.name = "Rim Hole Number"
        pRimHoleNumber.type = "int32"
        pRimHoleNumber.value = disk.rimHoleNumber.toString()
        
        diskBlock.parameters.add(pHoleArrangementNumber)
        pHoleArrangementNumber.name = "Hole Arrangement Number"
        pHoleArrangementNumber.type = "int32"
        pHoleArrangementNumber.value = disk.holeArrangementNumber.toString()
        
        diskBlock.parameters.add(pBoltHoleCircle)
        pBoltHoleCircle.name = "Bolt Hole Circle"
        pBoltHoleCircle.type = "int32"
        pBoltHoleCircle.value = disk.boltHoleCircleInMM.toString()
        
        diskBlock.parameters.add(pBrakeDiskThickness)
        pBrakeDiskThickness.name = "Brake Disk Thickness"
        pBrakeDiskThickness.type = "int32"
        pBrakeDiskThickness.value = disk.brakeDiskThicknessInMM.toString()
        
        diskBlock.parameters.add(pMinimumThickness)
        pMinimumThickness.name = "Minimum Thickness"
        pMinimumThickness.type = "int32"
        pMinimumThickness.value = disk.minimumThicknessInMM.toString()
        
        diskBlock.parameters.add(pVentilated)
        pVentilated.name = "Ventilated"
        pVentilated.type = "boolean"
        pVentilated.value = disk.ventilated.toString()
        
       
        
    }
}
        
