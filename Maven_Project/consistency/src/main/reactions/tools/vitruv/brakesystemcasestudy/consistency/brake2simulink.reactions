// Routine for creating a Simulink block and register it


routine createAndRegisterBrakeHose(brakesystem::BrakeHose hose) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to hose.eContainer()
        require absence of simulink::Block corresponding to hose
    }

create {
       // Create the Simulink block

        val hoseBlock = new simulink::Block
    }
    update {
        hoseBlock.name = hose.id
        // Add the susbsystem to the Simulink model
        mSimulink.contains += hoseBlock
        // create correspondence for retrival
        addCorrespondenceBetween(hose, hoseBlock)
    }

 }


// Routine for Add Brake Hose-Specific parameters


routine addBrakeHoseSpecificParameters(brakesystem::BrakeHose hose) {
    match {
        // Retrieve the block corresponding to this Brake Hose
        val hoseBlock = retrieve Simulink::Block corresponding to hose
    }
    create {
        // Add parameters specific to BrakeHose
        val pSpecificationType = new simulink::Parameter
        val pOEM_Number = new simulink::Parameter
        val pFittingPosition = new simulink::Parameter
        val pThreadSize1 = new simulink::Parameter
        val pThreadSize2 = new simulink::Parameter
        val pLength = new simulink::Parameter
    }
    }
  update {
   
       // Assign parameter to the block 
      
        
        // Common BrakeComponent parameters
        hoseBlock.parameters.add(pSpecificationType)
        pSpecificationType.name = "Specification Type"
        pSpecificationType.type = "string"
        pSpecificationType.value = hose.specificationType
        
        hoseBlock.parameters.add(pOEM_Number)
        pOEM_Number.name = "OEM Number"
        pOEM_Number.type = "string"
        pOEM_Number.value = hose.OEM_number

        hoeBlock.parameters.add(pFittingPosition)
        pFittingPosition.name = "Fitting Position"
        pFittingPosition.type = "string"
        pFittingPosition.value = hose.fittingPosition


        // BrakeHose-specific parameters
 
        hoseBlock.parameters.add(pThreadSize1)
        pThreadSize1.name = "Thread 1"
        pThreadSize1.type = "string"
        pThreadSize1.value = hose.threadSize1
        
        hoseBlock.parameters.add(pThreadSize2)
        pThreadSize2.name = "Thread 2"
        pThreadSize2.type = "string"
        pThreadSize2.value = hose.threadSize2
        
        hoseBlock.parameters.add(pLength)
        pLength.name = "Length"
        pLength.type = "int32"
        pLength.value = hose.lengthInMM.toString()
        
 }
}


// Reactions for Brake Hose Parameter Changes


reaction ThreadSize1Changed {
    after attribute replaced at brakesystem::BrakeHose[threadSize1]
    call updateThreadSize1(affectedEObject)
}

reaction ThreadSize2Changed {
    after attribute replaced at brakesystem::BrakeHose[threadSize2]
    call updateThreadSize2(affectedEObject)
}

reaction LengthChangedHose {
    after attribute replaced at brakesystem::BrakeHose[lengthInMM]
    call updateLengthHose(affectedEObject)
}

// Routines for Brake Hose Parameter Changes

routine updateThreadSize1(brakesystem::BrakeHose hose) {
    match {
        val hoseBlock = retrieve simulink::Block corresponding to hose
    }
    
    update {
        var pThreadSize1 = hoseBlock.parameters.findFirst[p | p.name == "Thread 1"]
        if (pThreadSize1 === null) {
            pThreadSize1 = new simulink::Parameter
            pThreadSize1.name = "Thread 1"
            pThreadSize1.type = "string"
            hoseBlock.parameters.add(pThreadSize1)
        }
        pThreadSize1.value = hose.threadSize1
    }
}


routine updateThreadSize2(brakesystem::BrakeHose hose) {
    match {
        val hoseBlock = retrieve simulink::Block corresponding to hose
    }
   
    update {
        var pThreadSize2 = hoseBlock.parameters.findFirst[p | p.name == "Thread 2"]
        if (pThreadSize2 === null) {
            pThreadSize2 = new simulink::Parameter
            pThreadSize2.name = "Thread 2"
            pThreadSize2.type = "string"
            hoseBlock.parameters.add(pThreadSize2)
        }
        pThreadSize2.value = hose.threadSize2
    }
}

routine updateLengthHose(brakesystem::BrakeHose hose) {
    match {
        val hoseBlock = retrieve simulink::Block corresponding to hose
    }

 update {
        var pLength = hoseBlock.parameters.findFirst[p | p.name == "Length"]
        if (pLength === null) {
            pLength = new simulink::Parameter
            pLength.name = "Length"
            pLength.type = "int32"
            hoseBlock.parameters.add(pLength)
        }
        pLength.value = hose.lengthInMM.toString()
    }
}


// Reactions for ABSSensor


reaction ABSSensorInserted {
    after element brakesystem::ABSSensor inserted in brakesystem::Brakesystem[BrakeComponents]
    call {
         createAndRegisterABSSensor(newValue)
         addABSSensorSpecificParameters(newValue)
        }
}


// Routine for creating a Simulink block and register it


routine createAndRegisterBrakeHose(brakesystem::BrakeHose hose) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to sensor.eContainer()
        require absence of simulink::Block corresponding to sensor
    }

create {
       // Create the Simulink block

        val sensorBlock = new simulink::Block
    }
    update {
        sensorBlock.name = sensor.id
        // Add the susbsystem to the Simulink model
        mSimulink.contains += sensorBlock
        // create correspondence for retrival
        addCorrespondenceBetween(sensor, sensorBlock)
    }

 }


// Routine for Add ABSSensor-Specific parameters


routine addABSSensorSpecificParameters(brakesystem::ABSSensor sensor) {
    match {
        // Retrieve the block corresponding to this Brake Hose
        val sensorBlock = retrieve Simulink::Block corresponding to sensor
    }
    create {
        // Add parameters specific to ABSSensor
        val pSpecificationType = new simulink::Parameter
        val pOEM_Number = new simulink::Parameter
        val pFittingPosition = new simulink::Parameter
        val pSensorType = new simulink::Parameter
       val pFittingDepth = new simulink::Parameter
       val pNumberOfPins = new simulink::Parameter
       val pLength = new simulink::Parameter
    }
    }
  update {
   
       // Assign parameter to the block 
      
        
        // Common BrakeComponent parameters
        sensorBlock.parameters.add(pSpecificationType)
        pSpecificationType.name = "Specification Type"
        pSpecificationType.type = "string"
        pSpecificationType.value = sensor.specificationType
        
        sensorBlock.parameters.add(pOEM_Number)
        pOEM_Number.name = "OEM Number"
        pOEM_Number.type = "string"
        pOEM_Number.value = sensor.OEM_number

        sensorBlock.parameters.add(pFittingPosition)
        pFittingPosition.name = "Fitting Position"
        pFittingPosition.type = "string"
        pFittingPosition.value = sensor.fittingPosition


        // ABSSensor-specific parameters
 
        sensorBlock.parameters.add(pSensorType)
        pSensorType.name = "Sensor Type"
        pSensorType.type = "string"
        pSensorType.value = sensor.sensorType
        
        sensorBlock.parameters.add(pFittingDepth)
        pFittingDepth.name = "Fitting Depth"
        pFittingDepth.type = "int32"
        pFittingDepth.value = sensor.fittingDepth.toString()
        
       sensoBlock.parameters.add(pNumberOfPins)
       pNumberOfPins.name = "Number of Pins"
       pNumberOfPins.type = "int32"
       pNumberOfPins.value = sensor.numberOfPins.toString(


        sensorBlock.parameters.add(pLength)
        pLength.name = "Length"
        pLength.type = "int32"
        pLength.value = sensor.lengthInMM.toString()
        
 }
}




// Reactions for ABSSensor Parameter Changes



reaction SensorTypeChanged {
after attribute replaced at brakesystem::ABSSensor[sensorType]
call updateSensorType(affectedEObject)
}
reaction FittingDepthChanged {
after attribute replaced at brakesystem::ABSSensor[fittingDepth]
call updateFittingDepth(affectedEObject)
}
reaction NumberOfPinsChanged {
after attribute replaced at brakesystem::ABSSensor[numberOfPins]
call updateNumberOfPins(affectedEObject)
}
reaction LengthChanged {
after attribute replaced at brakesystem::ABSSensor[lengthInMM]
call updateLength(affectedEObject)
}


// Routines for ABSSensor Parameter Changes



routine updateSensorType(brakesystem::ABSSensor sensor) {
match {
val sensorBlock = retrieve simulink::Block corresponding to sensor
}

update {
var pSensorType = sensorBlock.parameters.findFirst[p | p.name == "Sensor Type"]
if (pSensorType === null) {
pSensorType = new simulink::Parameter
pSensorType.name = "Sensor Type"
pSensorType.type = "string"
block.parameters.add(pSensorType)
}
pSensorType.value = sensor.sensorType
}
}


routine updateFittingDepth(brakesystem::ABSSensor sensor) {
match {
val sensorBlock = retrieve simulink::Block corresponding to sensor
}
update {
var pFittingDepth = sensorBlock.parameters.findFirst[p | p.name == "Fitting Depth"]
if (pFittingDepth === null) {
pFittingDepth = new simulink::Parameter
pFittingDepth.name = "Fitting Depth"
pFittingDepth.type = "int32"
block.parameters.add(pFittingDepth)
}
pFittingDepth.value = sensor.fittingDepth.toString()
}
}


routine updateNumberOfPins(brakesystem::ABSSensor sensor) {
match {
val sensorBlock = retrieve simulink::Block corresponding to sensor
}

update {
var pNumberOfPins = sensorBlock.parameters.findFirst[p | p.name == "Number of Pins"]
if (pNumberOfPins === null) {
pNumberOfPins = new simulink::Parameter
pNumberOfPins.name = "Number of Pins"
pNumberOfPins.type = "int32"
block.parameters.add(pNumberOfPins)
}
pNumberOfPins.value = sensor.numberOfPins.toString()
}
}


routine updateLength(brakesystem::ABSSensor sensor) {
match {
val sensorBlock = retrieve simulink::Block corresponding to sensor
}

update {
var pLength = sensorBlock.parameters.findFirst[p | p.name == "Length"]
if (pLength === null) {
pLength = new simulink::Parameter
pLength.name = "Length"
pLength.type = "int32"
block.parameters.add(pLength)
}
pLength.value = sensor.lengthInMM.toString()
}
}

