\\ Reactions for inserting Brake Caliper

reaction BrakeCaliperInserted {
    after element brakesystem::BrakeCaliper inserted in brakesystem::Brakesystem[BrakeComponents]
    call {
         createAndRegisterBrakeCaliper(newValue)
         addBrakeCaliperSpecificParameters(newValue)
        }
}


// Routine for creating a Simulink subsystem and register it


routine createAndRegisterBrakeCaliper(brakesystem::BrakeCaliper caliper) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to caliper.eContainer()
        require absence of simulink::SubSystem corresponding to caliper
    }

create {
       // Create the Simulink susbsystem

        val subsystem = new simulink::SubSystem
    }
    update {
        susbsystem.name = caliper.id
        // Add the susbsystem to the Simulink model
        mSimulink.contains += subsystem
        // create correspondence for retrival
        addCorrespondenceBetween(caliper, subsystem)
    }

 }





// Routine for Add Brake Caliper-Specific parameters
routine addBrakeCaliperSpecificParameters(brakesystem::BrakeCaliper caliper) {
    match {
        // Retrieve the susbsystem corresponding to this Brake Caliper
        val subsystem = retrieve Simulink::SubSystem corresponding to caliper
    }
    create {
        // Add parameters specific to BrakeCaliper
        
        val pSpecificationType = new simulink::Parameter
        val pOEM_Number = new simulink::Parameter
        val pFittingPosition = new simulink::Parameter
        val pPistonDiameter = new simulink::Parameter
        val pBrakeDiskThickness =  new Simulink::Parameter
       
    }
  update {
   
       // Assign parameter to the subsystem 
      
        
        // Common BrakeComponent parameters
        subsystem.parameters.add(pSpecificationType)
        pSpecificationType.name = "Specification Type"
        pSpecificationType.type = "string"
        pSpecificationType.value = caliper.specificationType
        
        subsystem.parameters.add(pOEM_Number)
        pOEM_Number.name = "OEM Number"
        pOEM_Number.type = "string"
        pOEM_Number.value = caliper.OEM_number
        
        subsystem.parameters.add(pFittingPosition)
        pFittingPosition.name = "Fitting Position"
        pFittingPosition.type = "string"
        pFittingPosition.value = caliper.fittingPosition
        
        // Brake Caliper-specific parameters

        subsystem.parameters.add(pPistonDiameter)
        pPistonDiameter.name = "Piston Diameter"
        pPisoDiameter.type = "int32"
        pPistonDiameter.value = caliper.pistonDiameterInMM.toString()
        
        susbsystem.parameters.add(pBrakeDiskThickness)
        pBrakeDiskThickness.name = "Brake Disk Thickness"
        pBrakeDiskThickness.type = "int32"
        pBrakeDiskThickness.value = caliper.brakeDiskThickness.toString()
        
        
        
    }
}


// Reactions for Brake Caliper Parameter Changes

reaction PistonDiameterChanged {
    after attribute replaced at brakesystem::BrakeCaliper[pistonDiameterInMM]
    call updatePistonDiameter(affectedEObject)
}

reaction BrakeDiskThicknessChangedCaliper {
    after attribute replaced at brakesystem::BrakeCaliper[brakeDiskThickness]
    call updateBrakeDiskThicknessCaliper(affectedEObject)
}


// Routines for Brake Caliper parameter Changes


routine updatePistonDiameter(brakesystem::BrakeCaliper caliper) {
    match {
        val subsystem = retrieve simulink::SubSystem corresponding to caliper
    }
    
    update {
        var pPistonDiameter = subsystem.parameters.findFirst[p | p.name == "Piston Diameter"]
        if (pPistonDiameter === null) {
            pPistonDiameter = new simulink::Parameter
            pPistonDiameter.name = "Piston Diameter"
            pPistonDiameter.type = "int32"
            subsystem.parameters.add(pPistonDiameter)
        }
        pPistonDiameter.value = caliper.pistonDiameterInMM.toString()
    }
}




routine updateBrakeDiskThicknessCaliper(brakesystem::BrakeCaliper caliper) {
    match {
        val subsystem = retrieve simulink::SubSystem corresponding to caliper
    }
  
    update {
        var pBrakeDiskThickness = subsystem.parameters.findFirst[p | p.name == "Brake Disk Thickness"]
        if (pBrakeDiskThickness === null) {
            pBrakeDiskThickness = new simulink::Parameter
            pBrakeDiskThickness.name = "Brake Disk Thickness"
            pBrakeDiskThickness.type = "int32"
            subsystem.parameters.add(pBrakeDiskThickness)
        }
        pBrakeDiskThickness.value = caliper.brakeDiskThickness.toString()
    }
}


// Reactions for Brake Pad


reaction BrakePadInserted {
    after element brakesystem::BrakePad inserted in brakesystem::Brakesystem[BrakeComponents]
    call {
         createAndRegisterBrakePad(newValue)
         addBrakePadSpecificParameters(newValue)
        }
}


// Routine for creating a Simulink block and register it


routine createAndRegisterBrakePad(brakesystem::BrakePad pad) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to pad.eContainer()
        require absence of simulink::Block corresponding to pad
    }

create {
       // Create the Simulink block

        val padBlock = new simulink::Block
    }
    update {
        padBlock.name = pad.id
        // Add the susbsystem to the Simulink model
        mSimulink.contains += padBlock
        // create correspondence for retrival
        addCorrespondenceBetween(pad, padBlock)
    }

 }


// Routine for Add Brake Pad-Specific parameters
routine addBrakePadSpecificParameters(brakesystem::BrakePad pad) {
    match {
        // Retrieve the block corresponding to this Brake Pad
        val padBlock = retrieve Simulink::Block corresponding to pad
    }
    create {
        // Add parameters specific to BrakePad
        val pSpecificationType = new simulink::Parameter
        val pOEM_Number = new simulink::Parameter
        val pFittingPosition = new simulink::Parameter
        val pHeight = new simulink::Parameter
        val pWidth = new simulink::Parameter
        val pThickness = new simulink::Parameter
        val pWearWarning = new simulink::Parameter
    }
    }
  update {
   
       // Assign parameter to the block 
      
        
        // Common BrakeComponent parameters
        padBlock.parameters.add(pSpecificationType)
        pSpecificationType.name = "Specification Type"
        pSpecificationType.type = "string"
        pSpecificationType.value = pad.specificationType
        
        padBlock.parameters.add(pOEM_Number)
        pOEM_Number.name = "OEM Number"
        pOEM_Number.type = "string"
        pOEM_Number.value = pad.OEM_number

        padBlock.parameters.add(pFittingPosition)
        pFittingPosition.name = "Fitting Position"
        pFittingPosition.type = "string"
        pFittingPosition.value = pad.fittingPosition


        // BrakePad-specific parameters
 
        padBlock.parameters.add(pHeight)
        pHeight.name = "Height"
        pHeight.type = "int32"
        pHeight.value = pad.heightInMM.toString()
        
        padBlock.parameters.add(pWidth)
        pWidth.name = "Width"
        pWidth.type = "int32"
        pWidth.value = pad.widthInMM.toString()
        
        padBlock.parameters.add(pThickness)
        pThickness.name = "Thickness"
        pThickness.type = "int32"
        pThickness.value = pad.thicknessInMM.toString()
        
        padBlock.parameters.add(pWearWarning)
        pWearWarning.name = "Wear Warning"
        pWearWarning.type = "int32"
        pWearWarning.value = pad.wearWarning.toString()
        
 }
}



