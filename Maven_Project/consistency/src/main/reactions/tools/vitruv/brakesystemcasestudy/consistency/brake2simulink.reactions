// Routines for parameter changes

routine updateDiameter(brakesystem::BrakeDisk disk) {
    match {
        val diskBlock = retrieve simulink::Block corresponding to disk
    }
    
    update {
        var pDiameter = diskBlock.parameters.findFirst[p | p.name == "Diameter"]
        if (pDiameter === null) {
            pDiameter = new simulink::Parameter
            pDiameter.name = "Diameter"
            pDiameter.type = "int32"
            diskBlock.parameters.add(pDiameter)
        }
        pDiameter.value = disk.diameterInMM.toString()
    }
}

