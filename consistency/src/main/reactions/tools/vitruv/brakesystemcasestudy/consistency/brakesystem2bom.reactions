}
reaction PadThicknessChanged {
    after attribute replaced at brakesystem::BrakePad[thicknessInMM]
    call synchronizeParameters(affectedEObject)
}

routine synchronizeParameters(brakesystem::BrakeComponent component) {
    match {
        val item = retrieve bom::Item corresponding to component
    }
    update {
        putString(item, "Specification Type", component.specificationType)
        putString(item, "OEM Number", component.OEM_number)
        putString(item, "Fitting Position", component.fittingPosition)
        if (component instanceof ABSSensor) {
            val sensor = component as ABSSensor
            putString(item, "Sensor Type", sensor.sensorType)
            putInteger(item, "Fitting Depth", sensor.fittingDepth)
            putInteger(item, "Number of Pins", sensor.numberOfPins)
            putInteger(item, "Length", sensor.lengthInMM)
        } else if (component instanceof BrakeCaliper) {
            val caliper = component as BrakeCaliper
            putInteger(item, "Piston Diameter", caliper.pistonDiameterInMM)
            putInteger(item, "Brake Disk Thickness", caliper.brakeDiskThickness)
        } else if (component instanceof BrakeHose) {
            val hose = component as BrakeHose
            putString(item, "Thread 1", hose.threadSize1)
            putString(item, "Thread 2", hose.threadSize2)
            putInteger(item, "Length", hose.lengthInMM)
        } else if (component instanceof BrakeDisk) {
            val disk = component as BrakeDisk
            putInteger(item, "Diameter", disk.diameterInMM)
            putInteger(item, "Centering Diameter", disk.centeringDiameterInMM)
            putInteger(item, "Rim Hole Number", disk.rimHoleNumber)
            putInteger(item, "Hole Arrangement Number", disk.holeArrangementNumber)
            putInteger(item, "Bolt Hole Circle", disk.boltHoleCircleInMM)
            putInteger(item, "Brake Disk Thickness", disk.brakeDiskThicknessInMM)
            putInteger(item, "Minimum Thickness", disk.minimumThicknessInMM)
            putBoolean(item, "Ventilated", disk.ventilated)
        } else if (component instanceof BrakePad) {
            val pad = component as BrakePad
            putInteger(item, "Height", pad.heightInMM)
            putInteger(item, "Width", pad.widthInMM)
            putInteger(item, "Thickness", pad.thicknessInMM)
            putBoolean(item, "Wear Warning", pad.wearWarning)
        }
    }
}

// A definition and value are created together. Later changes only replace
// the value, so the references used by bom2brakesystem remain stable.
routine putString(bom::Item item, String name, String newValue) {
    update {
        val existing = item.parameterValues.findFirst[p | p.definition !== null && p.definition.name == name] as StringParameterValue
        if (existing === null) {
            var definition = item.type.parameterDefinitions.findFirst[d | d.name == name]
            if (definition === null) {
                definition = BomFactory.eINSTANCE.createParameterDefinition()
                definition.name = name
                definition.dataType = DataType.ESTRING
                item.type.parameterDefinitions.add(definition)
            }
            val value = BomFactory.eINSTANCE.createStringParameterValue()
            value.definition = definition
            value.value = newValue
            item.parameterValues.add(value)
        } else if (!Objects.equals(existing.value, newValue)) {
            existing.value = newValue
        }
    }
}

routine putInteger(bom::Item item, String name, Integer newValue) {
    update {
        val existing = item.parameterValues.findFirst[p | p.definition !== null && p.definition.name == name] as IntegerParameterValue
        if (existing === null) {
            var definition = item.type.parameterDefinitions.findFirst[d | d.name == name]
            if (definition === null) {
                definition = BomFactory.eINSTANCE.createParameterDefinition()
                definition.name = name
                definition.dataType = DataType.EINT
                item.type.parameterDefinitions.add(definition)
            }
            val value = BomFactory.eINSTANCE.createIntegerParameterValue()
            value.definition = definition
            value.value = newValue
            item.parameterValues.add(value)
        } else if (existing.value != newValue) {
            existing.value = newValue
        }
    }
}

routine putBoolean(bom::Item item, String name, Boolean newValue) {
    update {
        val existing = item.parameterValues.findFirst[p | p.definition !== null && p.definition.name == name] as BoolParameterValue
        if (existing === null) {
            var definition = item.type.parameterDefinitions.findFirst[d | d.name == name]
            if (definition === null) {
                definition = BomFactory.eINSTANCE.createParameterDefinition()
                definition.name = name
                definition.dataType = DataType.EBOOLEAN
                item.type.parameterDefinitions.add(definition)
            }
            val value = BomFactory.eINSTANCE.createBoolParameterValue()
            value.definition = definition
            value.value = newValue
            item.parameterValues.add(value)
        } else if (existing.value != newValue) {
            existing.value = newValue
        }
    }
}

reaction BrakeComponentDeleted {
    after element brakesystem::BrakeComponent deleted
    call deleteBOMItemOrDecreaseQuantity(affectedEObject)
}

routine deleteBOMItemOrDecreaseQuantity(brakesystem::BrakeComponent component) {
    match {
        val item = retrieve bom::Item corresponding to component
    }
    update {
        removeCorrespondenceBetween(component, item)
        val remaining = getCorrespondingElements(item, BrakeComponent, null, null).size
        if (remaining == 0) {
            removeObject(item)
        } else if (item.numberOfItems != remaining) {
            item.numberOfItems = remaining
        }
    }
}
