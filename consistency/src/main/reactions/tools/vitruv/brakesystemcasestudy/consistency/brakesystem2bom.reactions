import java.io.File
import java.util.Objects

import brakesystem.ABSSensor
import brakesystem.BrakeCaliper
import brakesystem.BrakeComponent
import brakesystem.BrakeDisk
import brakesystem.BrakeHose
import brakesystem.BrakePad
import bom.BomFactory
import bom.DataType
import bom.StringParameterValue
import bom.IntegerParameterValue
import bom.BoolParameterValue

import "http://www.example.org/brakesystem" as brakesystem
import "http://example.org/bom" as bom

reactions: brakesystem2bom
in reaction to changes in brakesystem
execute actions in bom

reaction BrakesystemInsertedAsRoot {
    after element brakesystem::Brakesystem inserted as root
    call createBOM(newValue)
}

routine createBOM(brakesystem::Brakesystem source) {
    match {
        require absence of bom::BOM corresponding to source
    }
    create {
        val target = new bom::BOM
    }
    update {
        target.name = source.instanceName
        persistProjectRelative(source, target, new File("").toString() + "example.bom")
        addCorrespondenceBetween(source, target)
    }
}

reaction BrakesystemNameChanged {
    after attribute replaced at brakesystem::Brakesystem[instanceName]
    call updateBOMName(affectedEObject)
}

routine updateBOMName(brakesystem::Brakesystem source) {
    match {
        val target = retrieve bom::BOM corresponding to source
    }
    update {
        if (!Objects.equals(target.name, source.instanceName)) target.name = source.instanceName
    }
}

// A brake component not yet represented in the BOM starts a new item with
// quantity one. Components created from a BOM item already have a correspondence.
reaction BrakeComponentInserted {
    after element brakesystem::BrakeComponent inserted in brakesystem::Brakesystem[BrakeComponents]
    call createBOMItem(newValue)
}

routine createBOMItem(brakesystem::BrakeComponent component) {
    match {
        val target = retrieve bom::BOM corresponding to component.eContainer()
        require absence of bom::Item corresponding to component
    }
    create {
        val item = new bom::Item
        val type = new bom::ItemType
    }
    update {
        type.name = component.eClass().name
        // Item.type is a non-containment reference, so its ItemType must be a root.
        persistProjectRelative(component, type, new File("").toString() + "example.bom")
        item.type = type
        item.id = component.id
        item.numberOfItems = 1
        target.items.add(item)
        addCorrespondenceBetween(component, item)
        synchronizeParameters(component)
    }
}

// A BOM item may correspond to several brake components. Only a one-to-one
// item can take its id directly from a brake component.
reaction BrakeComponentIdChanged {
    after attribute replaced at brakesystem::BrakeComponent[id]
    call updateBOMItemId(affectedEObject)
}

routine updateBOMItemId(brakesystem::BrakeComponent component) {
    match {
        val item = retrieve bom::Item corresponding to component
    }
    update {
        if (item.numberOfItems == 1 && !Objects.equals(item.id, component.id)) {
            item.id = component.id
        }
    }
}

// Every feature mapped by bom2brakesystem calls the same routine. It writes
// the full current state, making insertion and later attribute changes agree.
reaction SpecificationTypeChanged {
    after attribute replaced at brakesystem::BrakeComponent[specificationType]
    call synchronizeParameters(affectedEObject)
}
reaction OEMNumberChanged {
    after attribute replaced at brakesystem::BrakeComponent[OEM_number]
    call synchronizeParameters(affectedEObject)
}
reaction FittingPositionChanged {
    after attribute replaced at brakesystem::BrakeComponent[fittingPosition]
    call synchronizeParameters(affectedEObject)
}
reaction SensorTypeChanged {
    after attribute replaced at brakesystem::ABSSensor[sensorType]
    call synchronizeParameters(affectedEObject)
}
reaction FittingDepthChanged {
    after attribute replaced at brakesystem::ABSSensor[fittingDepth]
    call synchronizeParameters(affectedEObject)
}
reaction NumberOfPinsChanged {
    after attribute replaced at brakesystem::ABSSensor[numberOfPins]
    call synchronizeParameters(affectedEObject)
}
reaction SensorLengthChanged {
