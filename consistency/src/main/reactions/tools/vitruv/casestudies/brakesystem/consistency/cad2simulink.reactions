import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality
import java.util.Arrays

import tools.vitruv.casestudies.brakesystem.consistency.Cad2SimulinkUtility;
import tools.vitruv.casestudies.brakesystem.consistency.CadUtility;
import simulink.SimulinkModel;
import tools.vitruv.casestudies.brakesystem.consistency.ParameterValueUtility;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import simulink.Block;
import brakesystem.BrakeComponent;
import brakesystem.BrakeCaliper;
import simulink.SubSystem;
import edu.kit.ipd.sdq.metamodels.cad.Assembly;
import edu.kit.ipd.sdq.metamodels.cad.Constraint;

import "http://www.example.org/simulink" as simulink
import "http://demonstrator.kit.edu/cad" as cad

// A Simulink block of a physical part corresponds to a part of the CAD document, i.e. an Assembly
// (see CadUtility). The block name is the label of the part. The blocks of a subsystem are the
// parts nested in the subsystem's part. Only dimensions are part of the overlap: a named
// dimensional constraint of the part is a numeric parameter of the block, lengths in millimetres.

reactions: cad2simulink
in reaction to changes in cad
execute actions in simulink

// Insertion Reactions
reaction CADDocumentInsertedAsRoot {
    after element cad::CADDocument inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(cad::CADDocument document) {
    match {
        require absence of simulink::SimulinkModel corresponding to document
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, document, SimulinkModel)
        if (existing !== null) {
            addCorrespondenceBetween(document, existing)
        } else {
            createRoot(document)
        }
    }
}

routine createRoot(cad::CADDocument document) {
    match {
        require absence of simulink::SimulinkModel corresponding to document
    }
    create {
        val mSimulink = new simulink::SimulinkModel
    }
    update {
        mSimulink.name = document.name
        persistProjectRelative(document, mSimulink, "example.simulink")
        addCorrespondenceBetween(document, mSimulink)
    }
}

reaction PartInsertedInDocument {
    after element cad::Assembly inserted in cad::CADDocument[objects]
    call createOrPlaceBlock(newValue)
}

reaction PartInsertedInPart {
    after element cad::Assembly inserted in cad::Assembly[children]
    call createOrPlaceBlock(newValue)
}

// A part that already has a block was moved: the block follows into the subsystem of the new
// parent part, or to the top level of the model
routine createOrPlaceBlock(cad::Assembly part) {
    update {
        val block = getCorrespondingElements(part, Block, null, null).head
        if (block === null) {
            createAndRegisterPart(part)
        } else {
            placeBlock(part, block)
        }
    }
}

routine placeBlock(cad::Assembly part, simulink::Block block) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to CadUtility.documentOf(part)
    }
    update {
        val parent = CadUtility.parentPart(part)
        if (parent === null) {
            if (block.eContainer !== mSimulink) mSimulink.contains += block
            return
        }
        val subsystem = getCorrespondingElements(parent, SubSystem, null, null).head
        if (subsystem !== null && block.eContainer !== subsystem) {
            subsystem.subBlocks += block
        }
    }
}

routine createAndRegisterPart(cad::Assembly part) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to CadUtility.documentOf(part)
        require absence of simulink::Block corresponding to part
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, part, Block)
        if (existing !== null) {
            addCorrespondenceBetween(part, existing)
        } else {
            createAndRegisterPartDirectly(part)
        }
        // Parameters may have been added together with the part
        for (parameter : CadUtility.parameters(part)) createAndRegisterNumericParameter(parameter)
    }
}

routine createAndRegisterPartDirectly(cad::Assembly part) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to CadUtility.documentOf(part)
        require absence of simulink::Block corresponding to part
    }
    update {
        // A known brake component determines the kind of block: calipers contain their pads.
        // Other physical parts are not necessarily simulated (e.g. bolts), so the user may choose "None".
        val brakeComponent = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, part, BrakeComponent)
        val componentType = if (brakeComponent instanceof BrakeCaliper) {
            1
        } else if (brakeComponent !== null) {
            0
        } else {
            userInteractor.singleSelectionDialogBuilder.message(
                "What Simulink component do you want to add to be correspondent to this part?").choices(
                Arrays.asList("SimulinkBlock","SimulinkSubsystem","None")).windowModality(WindowModality.MODAL).
                startInteraction
        }
        switch (componentType) {
            case 0:
                createSimulinkBlock(part, mSimulink)
            case 1:
                createSimulinkSubsystem(part, mSimulink)
            default:
                return // Do nothing
        }
    }
}

routine createSimulinkBlock(cad::Assembly part, simulink::SimulinkModel mSimulink) {
    create {
        val mBlock = new simulink::Block
    }
    update {
        mBlock.name = part.label
        insertSimulinkBlock(part, mSimulink, mBlock)
        addCorrespondenceBetween(part, mBlock)
    }
}

routine createSimulinkSubsystem(cad::Assembly part, simulink::SimulinkModel mSimulink) {
    create {
        val mSubsystem = new simulink::SubSystem
    }
    update {
        mSubsystem.name = part.label
        insertSimulinkBlock(part, mSimulink, mSubsystem)
        addCorrespondenceBetween(part, mSubsystem)
    }
}

routine insertSimulinkBlock(cad::Assembly part, simulink::SimulinkModel mSimulink, simulink::Block mBlock) {
    update {
        // A part nested in the part of a subsystem belongs into that subsystem
        val parent = CadUtility.parentPart(part)
        val parentSubsystem = if (parent !== null) getCorrespondingElements(parent, SubSystem, null, null).head
        if (parentSubsystem !== null) {
            parentSubsystem.subBlocks += mBlock
            return
        }
        // A known brake component determines the position: a pad belongs into the subsystem of its caliper
        val brakeComponent = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, part, BrakeComponent)
        if (brakeComponent !== null) {
            val container = brakeComponent.eContainer
            val caliperSubsystem = if (container instanceof BrakeCaliper) {
                TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, container, SubSystem)
            }
            if (caliperSubsystem !== null) {
                caliperSubsystem.subBlocks += mBlock
            } else {
                mSimulink.contains += mBlock
            }
            return
        }
        val subsystems = Cad2SimulinkUtility.getAllSubSystems(mSimulink)
        var chosen = 0
        if (subsystems.size() > 0) {
            val choices = #["Insert at root level"] + subsystems.map[name]
            chosen = userInteractor.singleSelectionDialogBuilder.message(
                "Where do you want to insert the new Simulink component?").choices(choices).windowModality(WindowModality.MODAL).
                startInteraction
        }

        if (chosen > 0 && chosen <= subsystems.size) {
            subsystems.get(chosen - 1).subBlocks += mBlock
        } else {
            mSimulink.contains += mBlock
        }
    }
}

//
//// Parameters (named dimensional constraints, see CadUtility)
//

reaction ParameterInserted {
    after element cad::Constraint inserted in cad::Sketch[constraints]
    call createAndRegisterNumericParameter(newValue)
}

reaction ParameterSketchInserted {
    after element cad::Sketch inserted in cad::Assembly[children]
    call createAndRegisterNumericParameters(newValue)
}

routine createAndRegisterNumericParameters(cad::Sketch sketch) {
    update {
        for (constraint : sketch.constraints) createAndRegisterNumericParameter(constraint)
    }
}

// A constraint becomes a parameter once it is named (or gets a dimensional type)
reaction ParameterTypeChanged {
    after attribute replaced at cad::Constraint[type]
    call createAndRegisterNumericParameter(affectedEObject)
}

routine createAndRegisterNumericParameter(cad::Constraint parameter) {
    match {
        require absence of simulink::Parameter corresponding to parameter
    }
    update {
        if (!CadUtility.isParameter(parameter)) {
            return
        }
        createAndRegisterNumericParameterOfPart(parameter, CadUtility.partOf(parameter))
    }
}

routine createAndRegisterNumericParameterOfPart(cad::Constraint parameter, cad::Assembly part) {
    match {
        val mBlock = retrieve simulink::Block corresponding to part
        require absence of simulink::Parameter corresponding to parameter
    }
    create {
        val mParameter = new simulink::Parameter
    }
    update {
        // A parameter with the same name may already have been created via the brake system model
        val sameName = mBlock.parameters.findFirst[name == parameter.name]
        if (sameName !== null && !TransitiveCorrespondenceUtility.hasDirectlyCorresponding(executionState.correspondenceModel, sameName, Constraint)) {
            addCorrespondenceBetween(parameter, sameName)
            return
        }
        mParameter.name = parameter.name
        mParameter.value = ParameterValueUtility.formatNumber(ParameterValueUtility.cadToSimulinkValue(parameter.value, CadUtility.unitOf(parameter)))
        val parametertype = userInteractor.singleSelectionDialogBuilder.message(
            "What Simulink Parametertype do you want to add to be correspondent to the CAD dimension '" + parameter.name + "'?").choices(
            Arrays.asList("double","single","half","uint8","int8","uint16","int16","uint32","int32","uint64","int64")).windowModality(WindowModality.MODAL).
            startInteraction
        switch (parametertype) {
            case 0:
                mParameter.type = "double"
            case 1:
                mParameter.type = "single"
            case 2:
                mParameter.type = "half"
            case 3:
                mParameter.type = "uint8"
            case 4:
                mParameter.type = "int8"
            case 5:
                mParameter.type = "uint16"
            case 6:
                mParameter.type = "int16"
            case 7:
                mParameter.type = "uint32"
            case 8:
                mParameter.type = "int32"
            case 9:
                mParameter.type = "uint64"
            case 10:
                mParameter.type = "int64"
            default:
                return // Do nothing
        }

        mBlock.parameters += mParameter
        addCorrespondenceBetween(parameter, mParameter)
    }
}


// Deletion Reactions

reaction ParameterDeleted {
    after element cad::Constraint deleted
    call deleteCorrespondingSimulinkParameter(affectedEObject)
}

routine deleteCorrespondingSimulinkParameter(cad::Constraint parameter) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update{
        removeObject(mParameter)
        removeCorrespondenceBetween(parameter, mParameter)
    }
}

reaction PartDeleted {
    after element cad::Assembly deleted
    call deleteCorrespondingSimulinkComponent(affectedEObject)
}

routine deleteCorrespondingSimulinkComponent(cad::Assembly part) {
    match {
        val mComponent = retrieve simulink::Block corresponding to part
    }
    update{
        removeObject(mComponent)
        removeCorrespondenceBetween(part, mComponent)
    }
}


// Update Reactions


reaction CADDocumentNameChanged {
    after attribute replaced at cad::CADDocument[name]
    call updateSimulinkModelName(affectedEObject)
}

routine updateSimulinkModelName(cad::CADDocument document) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to document
    }
    update {
        mSimulink.name = document.name
    }
}

reaction PartLabelChanged {
    after attribute replaced at cad::Assembly[label]
    call updateSimulinkComponentName(affectedEObject)
}

routine updateSimulinkComponentName(cad::Assembly part) {
    match {
        val mComponent = retrieve simulink::Block corresponding to part
    }
    update {
        if (mComponent.name != part.label) mComponent.name = part.label
    }
}

// A constraint that is named only now becomes a parameter
reaction ParameterNameChanged {
    after attribute replaced at cad::Constraint[name]
    call updateOrCreateSimulinkParameterName(affectedEObject)
}

routine updateOrCreateSimulinkParameterName(cad::Constraint parameter) {
    update {
        val mParameter = getCorrespondingElements(parameter, typeof(simulink.Parameter), null, null).head
        if (mParameter === null) {
            createAndRegisterNumericParameter(parameter)
        } else if (mParameter.name != parameter.name) {
            mParameter.name = parameter.name
        }
    }
}

reaction ParameterValueChanged {
    after attribute replaced at cad::Constraint[value]
    call updateSimulinkParameterValue(affectedEObject)
}

// Simulink values hold lengths in millimetres (see ParameterValueUtility). Values that already
// denote the same number are not rewritten, so a propagated change does not overwrite the
// user's formatting.
routine updateSimulinkParameterValue(cad::Constraint parameter) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update {
        val value = ParameterValueUtility.cadToSimulinkValue(parameter.value, CadUtility.unitOf(parameter))
        if (!ParameterValueUtility.denotesNumber(mParameter.value, value)) {
            mParameter.value = ParameterValueUtility.formatNumber(value)
        }
    }
}
