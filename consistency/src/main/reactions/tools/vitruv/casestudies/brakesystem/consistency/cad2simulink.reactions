import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality
import java.util.Arrays

import tools.vitruv.casestudies.brakesystem.consistency.Cad2SimulinkUtility;
import simulink.SimulinkModel;
import tools.vitruv.casestudies.brakesystem.consistency.ParameterValueUtility;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import simulink.Block;
import brakesystem.BrakeComponent;
import brakesystem.BrakeCaliper;
import simulink.SubSystem;

import "http://www.example.org/simulink" as simulink
import "http://www.example.org/cad" as cad

reactions: cad2simulink
in reaction to changes in cad
execute actions in simulink

// Insertion Reactions
reaction CAD_ModelInsertedAsRoot {
    after element cad::CAD_Model inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(cad::CAD_Model model) {
    match {
        require absence of simulink::SimulinkModel corresponding to model
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, model, SimulinkModel)
        if (existing !== null) {
            addCorrespondenceBetween(model, existing)
        } else {
            createRoot(model)
        }
    }
}

routine createRoot(cad::CAD_Model model) {
    match {
        require absence of simulink::SimulinkModel corresponding to model
    }
    create {
        val mSimulink = new simulink::SimulinkModel
    }
    update {
        mSimulink.name = model.name
        persistProjectRelative(model, mSimulink, "example.simulink")
        addCorrespondenceBetween(model, mSimulink)
    }
}

reaction NameSpaceInserted {
    after element cad::Namespace inserted in cad::CAD_Model[namespaces]
    call createAndRegisterNamespace(newValue)
}
routine createAndRegisterNamespace(cad::Namespace namespace) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to namespace.eContainer()
        require absence of simulink::Block corresponding to namespace
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, namespace, Block)
        if (existing !== null) {
            addCorrespondenceBetween(namespace, existing)
        } else {
            createAndRegisterNamespaceDirectly(namespace)
        }
    }
}

routine createAndRegisterNamespaceDirectly(cad::Namespace namespace) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to namespace.eContainer()
        require absence of simulink::Block corresponding to namespace
    }
    update {
        // A known brake component determines the kind of block: calipers contain their pads.
        // Other physical parts are not necessarily simulated (e.g. bolts), so the user may choose "None".
        val brakeComponent = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, namespace, BrakeComponent)
        val componentType = if (brakeComponent instanceof BrakeCaliper) {
            1
        } else if (brakeComponent !== null) {
            0
        } else {
            userInteractor.singleSelectionDialogBuilder.message(
                "What Simulink component do you want to add to be correspondent to this namespace?").choices(
                Arrays.asList("SimulinkBlock","SimulinkSubsystem","None")).windowModality(WindowModality.MODAL).
                startInteraction
        }
        switch (componentType) {
            case 0:
                createSimulinkBlock(namespace, mSimulink)
            case 1:
                createSimulinkSubsystem(namespace, mSimulink)
            default:
                return // Do nothing
        }
    }
}

routine createSimulinkBlock(cad::Namespace namespace, simulink::SimulinkModel mSimulink) {
    create {
        val mBlock = new simulink::Block
    }
    update {
        mBlock.name = namespace.name
        insertSimulinkBlock(namespace, mSimulink, mBlock)
        addCorrespondenceBetween(namespace, mBlock)
    }
}

routine createSimulinkSubsystem(cad::Namespace namespace, simulink::SimulinkModel mSimulink) {
    create {
        val mSubsystem = new simulink::SubSystem
    }
    update {
        mSubsystem.name = namespace.name
        insertSimulinkBlock(namespace, mSimulink, mSubsystem)
        addCorrespondenceBetween(namespace, mSubsystem)
    }
}

routine insertSimulinkBlock(cad::Namespace namespace, simulink::SimulinkModel mSimulink, simulink::Block mBlock) {
    update {
        // A known brake component determines the position: a pad belongs into the subsystem of its caliper
        val brakeComponent = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, namespace, BrakeComponent)
        if (brakeComponent !== null) {
            val container = brakeComponent.eContainer
            val caliperSubsystem = if (container instanceof BrakeCaliper) {
                TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, container, SubSystem)
            }
            if (caliperSubsystem !== null) {
                caliperSubsystem.subBlocks += mBlock
            } else {
                mSimulink.contains += mBlock
            }
            return
        }
        val subsystems = Cad2SimulinkUtility.getAllSubSystems(mSimulink)
        var chosen = 0
        if (subsystems.size() > 0) {
            val choices = #["Insert at root level"] + subsystems.map[name]
            chosen = userInteractor.singleSelectionDialogBuilder.message(
                "Where do you want to insert the new Simulink component?").choices(choices).windowModality(WindowModality.MODAL).
                startInteraction
        }
        
        if (chosen > 0 && chosen <= subsystems.size) {
            subsystems.get(chosen - 1).subBlocks += mBlock
        } else {
            mSimulink.contains += mBlock
        }
    }
}

reaction StringParameterInserted {
    after element cad::StringParameter inserted in cad::Namespace[parameters]
    call createAndRegisterStringParameter(newValue)
}

routine createAndRegisterStringParameter(cad::StringParameter parameter) {
    match {
        val mBlock = retrieve simulink::Block corresponding to parameter.eContainer()
        require absence of simulink::Parameter corresponding to parameter
    }
    create {
        val mParameter = new simulink::Parameter
    }
    update {
        // A parameter with the same name may already have been created via the brake system model
        val sameName = mBlock.parameters.findFirst[name == parameter.name]
        if (sameName !== null && !TransitiveCorrespondenceUtility.hasDirectlyCorresponding(executionState.correspondenceModel, sameName, typeof(edu.kit.ipd.sdq.metamodels.cad.Parameter))) {
            addCorrespondenceBetween(parameter, sameName)
            return
        }
        mParameter.name = parameter.name
        mParameter.value = parameter.value
        mParameter.type = "string"
        mBlock.parameters += mParameter
        addCorrespondenceBetween(parameter, mParameter)
    }
}


reaction NumericParameterInserted {
    after element cad::NumericParameter inserted in cad::Namespace[parameters]
    call createAndRegisterNumericParameter(newValue)
}

routine createAndRegisterNumericParameter(cad::NumericParameter parameter) {
    match {
        val mBlock = retrieve simulink::Block corresponding to parameter.eContainer()
        require absence of simulink::Parameter corresponding to parameter
    }
    create {
        val mParameter = new simulink::Parameter
    }
    update {
        // A parameter with the same name may already have been created via the brake system model
        val sameName = mBlock.parameters.findFirst[name == parameter.name]
        if (sameName !== null && !TransitiveCorrespondenceUtility.hasDirectlyCorresponding(executionState.correspondenceModel, sameName, typeof(edu.kit.ipd.sdq.metamodels.cad.Parameter))) {
            addCorrespondenceBetween(parameter, sameName)
            return
        }
        mParameter.name = parameter.name
        mParameter.value = ParameterValueUtility.formatNumber(ParameterValueUtility.cadToSimulinkValue(parameter.value, parameter.unit))
        val parametertype = userInteractor.singleSelectionDialogBuilder.message(
            "What Simulink Parametertype do you want to add to be correspondent to this Numeric CAD Parameter?").choices(
            Arrays.asList("double","single","half","uint8","int8","uint16","int16","uint32","int32","uint64","int64")).windowModality(WindowModality.MODAL).
            startInteraction
        switch (parametertype) {
            case 0:
                mParameter.type = "double"
            case 1:
                mParameter.type = "single"
            case 2:
                mParameter.type = "half"
            case 3:
                mParameter.type = "uint8"
            case 4:
                mParameter.type = "int8"
            case 5:
                mParameter.type = "uint16"
            case 6:
                mParameter.type = "int16"
            case 7:
                mParameter.type = "uint32"
            case 8:
                mParameter.type = "int32"
            case 9:
                mParameter.type = "uint64"
            case 10:
                mParameter.type = "int64"
            default:
                return // Do nothing
        }
        
        mBlock.parameters += mParameter
        addCorrespondenceBetween(parameter, mParameter)
    }
}

reaction BooleanParameterInserted {
    after element cad::BooleanParameter inserted in cad::Namespace[parameters]
    call createAndRegisterBooleanParameter(newValue)
}

routine createAndRegisterBooleanParameter(cad::BooleanParameter parameter) {
    match {
        val mBlock = retrieve simulink::Block corresponding to parameter.eContainer()
        require absence of simulink::Parameter corresponding to parameter
    }
    create {
        val mParameter = new simulink::Parameter
    }
    update {
        // A parameter with the same name may already have been created via the brake system model
        val sameName = mBlock.parameters.findFirst[name == parameter.name]
        if (sameName !== null && !TransitiveCorrespondenceUtility.hasDirectlyCorresponding(executionState.correspondenceModel, sameName, typeof(edu.kit.ipd.sdq.metamodels.cad.Parameter))) {
            addCorrespondenceBetween(parameter, sameName)
            return
        }
        mParameter.name = parameter.name
        mParameter.value = parameter.value.toString()
        mParameter.type = "boolean"
        mBlock.parameters += mParameter
        addCorrespondenceBetween(parameter, mParameter)
    }
}


// Deletion Reactions

reaction CAD_ParameterDeleted {
    after element cad::Parameter deleted
    call deleteCorrespondingSimulinkParameter(affectedEObject)
}

routine deleteCorrespondingSimulinkParameter(cad::Parameter parameter) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update{
        removeObject(mParameter)
        removeCorrespondenceBetween(parameter, mParameter)
    }
}

reaction NamespaceDeleted {
    after element cad::Namespace deleted
    call deleteCorrespondingSimulinkComponent(affectedEObject)
}

routine deleteCorrespondingSimulinkComponent(cad::Namespace namespace) {
    match {
        val mComponent = retrieve simulink::Block corresponding to namespace
    }
    update{
        removeObject(mComponent)
        removeCorrespondenceBetween(namespace, mComponent)
    }
}


// Update Reactions


reaction CAD_ModelNameChanged {
    after attribute replaced at cad::CAD_Model[name]
    call updateSimulinkModelName(affectedEObject)
}

routine updateSimulinkModelName(cad::CAD_Model model) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to model
    }
    update {
        mSimulink.name = model.name
    }
}

reaction NamespaceNameChanged {
    after attribute replaced at cad::Namespace[name]
    call updateSimulinkComponentName(affectedEObject)
}

routine updateSimulinkComponentName(cad::Namespace namespace) {
    match {
        val mComponent = retrieve simulink::Block corresponding to namespace
    }
    update {
        mComponent.name = namespace.name
    }
}

reaction ParameterNameChanged {
    after attribute replaced at cad::Parameter[name]
    call updateSimulinkParameterName(affectedEObject)
}

routine updateSimulinkParameterName(cad::Parameter parameter) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update {
        mParameter.name = parameter.name
    }
}

reaction StringParameterValueChanged {
    after attribute replaced at cad::StringParameter[value]
    call updateSimulinkStringParameterValue(affectedEObject)
}

routine updateSimulinkStringParameterValue(cad::StringParameter parameter) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update {
        if (mParameter.value != parameter.value) {
            mParameter.value = parameter.value
        }
    }
}

reaction NumericParameterValueChanged {
    after attribute replaced at cad::NumericParameter[value]
    call updateSimulinkNumericParameterValue(affectedEObject)
}

reaction NumericParameterUnitChanged {
    after attribute replaced at cad::NumericParameter[unit]
    call updateSimulinkNumericParameterValue(affectedEObject)
}

// Simulink values hold lengths in millimetres (see ParameterValueUtility). Values that already
// denote the same number are not rewritten, so a propagated change does not overwrite the
// user's formatting.
routine updateSimulinkNumericParameterValue(cad::NumericParameter parameter) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update {
        val value = ParameterValueUtility.cadToSimulinkValue(parameter.value, parameter.unit)
        if (!ParameterValueUtility.denotesNumber(mParameter.value, value)) {
            mParameter.value = ParameterValueUtility.formatNumber(value)
        }
    }
}

reaction BooleanParameterValueChanged {
    after attribute replaced at cad::BooleanParameter[value]
    call updateSimulinkBooleanParameterValue(affectedEObject)
}
routine updateSimulinkBooleanParameterValue(cad::BooleanParameter parameter) {
    match {
        val mParameter = retrieve simulink::Parameter corresponding to parameter
    }
    update {
        if (!ParameterValueUtility.denotesBoolean(mParameter.value, parameter.value)) {
            mParameter.value = parameter.value.toString()
        }
    }
}       
