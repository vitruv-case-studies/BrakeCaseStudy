import java.util.Arrays;
import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality;

import simulink.SubSystem;

import brakesystem.ABSSensor;
import brakesystem.BrakeCaliper;
import brakesystem.BrakeHose;
import brakesystem.BrakeDisk;
import brakesystem.BrakePad;

import tools.vitruv.casestudies.brakesystem.consistency.ParameterValueUtility;
import brakesystem.Brakesystem;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import brakesystem.BrakeComponent;
import autosar.SwComponentType;
import autosar.SensorActuatorSwComponentType;

import "http://www.example.org/simulink" as simulink
import "http://www.example.org/brakesystem" as brakesystem

reactions: simulink2brakesystem
in reaction to changes in simulink
execute actions in brakesystem

// Root

reaction SimulinkModelInsertedAsRoot {
    after element simulink::SimulinkModel inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(simulink::SimulinkModel model) {
    match {
        require absence of brakesystem::Brakesystem corresponding to model
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, model, Brakesystem)
        if (existing !== null) {
            addCorrespondenceBetween(model, existing)
        } else {
            createRoot(model)
        }
    }
}

routine createRoot(simulink::SimulinkModel model) {
    match {
        require absence of brakesystem::Brakesystem corresponding to model
    }
    create {
        val mBrakesystem = new brakesystem::Brakesystem
    }
    update {
        mBrakesystem.instanceName = model.name

        persistProjectRelative(model, mBrakesystem, "example.brakesystem")
        addCorrespondenceBetween(model, mBrakesystem)
    }
}

reaction SimulinkModelNameChanged {
    after attribute replaced at simulink::SimulinkModel[name]
    call updateBrakesystemInstanceName(affectedEObject, newValue)
}

routine updateBrakesystemInstanceName(simulink::SimulinkModel model, String newName) {
    match {
        val mBrakesystem = retrieve brakesystem::Brakesystem corresponding to model
    }
    update {
        mBrakesystem.instanceName = newName
    }
}

reaction SimulinkModelDeletedAsRoot {
    after element simulink::SimulinkModel deleted
    call deleteAndUnregisterRoot(affectedEObject)
}

routine deleteAndUnregisterRoot(simulink::SimulinkModel model) {
    match {
        val mBrakesystem = retrieve brakesystem::Brakesystem corresponding to model
    }
    update {
        removeCorrespondenceBetween(model, mBrakesystem)
        removeObject(mBrakesystem)
    }
}

// Blocks

reaction BlockInserted {
    after element simulink::Block inserted in simulink::SimulinkModel[contains]
    call createAndRegisterBrakeComponent(affectedEObject, newValue)
}

routine createAndRegisterBrakeComponent(simulink::SimulinkModel mSimulink, simulink::Block block) {
    match {
        val mBrakesystem = retrieve brakesystem::Brakesystem corresponding to mSimulink
        require absence of brakesystem::BrakeComponent corresponding to block
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, BrakeComponent)
        if (existing !== null) {
            addCorrespondenceBetween(block, existing)
        } else {
            createAndRegisterBrakeComponentDirectly(mSimulink, block)
        }
    }
}

routine createAndRegisterBrakeComponentDirectly(simulink::SimulinkModel mSimulink, simulink::Block block) {
    match {
        val mBrakesystem = retrieve brakesystem::Brakesystem corresponding to mSimulink
        require absence of brakesystem::BrakeComponent corresponding to block
    }
    update {
        // AUTOSAR already decides whether the block is a sensor (SensorActuatorSwComponentType <-> ABSSensor),
        // so the user cannot give a contradicting answer here
        val swComponent = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, SwComponentType)
        if (swComponent instanceof SensorActuatorSwComponentType) {
            createABSSensor(mBrakesystem, block)
            return
        }
        val choices = newArrayList("BrakeDisk", "BrakeHose")
        if (swComponent === null) {
            choices += "ABSSensor"
        }
        if (block instanceof SubSystem) {
            choices += "BrakeCaliper"
        } else {
            choices += "BrakePad"
        }
        // Blocks may also model parts that are no brake components, e.g. software or other hardware
        choices += "None"
        val chosen = userInteractor.singleSelectionDialogBuilder.message(
            "What brake component does this block represent?").choices(
            choices).windowModality(WindowModality.MODAL).startInteraction
        if (chosen < 0 || chosen >= choices.size) {
            return
        }
        switch (choices.get(chosen)) {
            case "BrakeDisk":
                createBrakeDisk(mBrakesystem, block)
            case "BrakeHose":
                createBrakeHose(mBrakesystem, block)
            case "ABSSensor":
                createABSSensor(mBrakesystem, block)
            case "BrakeCaliper":
                createBrakeCaliper(mBrakesystem, block)
            case "BrakePad":
                createBrakePad(mBrakesystem, block)
        }
    }
}

routine createBrakeDisk(brakesystem::Brakesystem mBrakesystem, simulink::Block block) {
    create {
        val brakeDisk = new brakesystem::BrakeDisk
    }
    update {
        brakeDisk.id = block.name
        mBrakesystem.getBrakeComponents().add(brakeDisk)
        addCorrespondenceBetween(block, brakeDisk)
    }
}

routine createBrakeHose(brakesystem::Brakesystem mBrakesystem, simulink::Block block) {
    create {
        val brakeHose = new brakesystem::BrakeHose
    }
    update {
        brakeHose.id = block.name
        mBrakesystem.getBrakeComponents().add(brakeHose)
        addCorrespondenceBetween(block, brakeHose)
    }
}

routine createABSSensor(brakesystem::Brakesystem mBrakesystem, simulink::Block block) {
    create {
        val absSensor = new brakesystem::ABSSensor
    }
    update {
        absSensor.id = block.name
        mBrakesystem.getBrakeComponents().add(absSensor)
        addCorrespondenceBetween(block, absSensor)
    }
}

routine createBrakeCaliper(brakesystem::Brakesystem mBrakesystem, simulink::Block block) {
    create {
        val brakeCaliper = new brakesystem::BrakeCaliper
    }
    update {
        brakeCaliper.id = block.name
        mBrakesystem.getBrakeComponents().add(brakeCaliper)
        addCorrespondenceBetween(block, brakeCaliper)
    }
}

routine createBrakePad(brakesystem::Brakesystem mBrakesystem, simulink::Block block) {
    create {
        val brakePad = new brakesystem::BrakePad
    }
    update {
        brakePad.id = block.name
        mBrakesystem.getBrakeComponents().add(brakePad)
        addCorrespondenceBetween(block, brakePad)
    }
}

reaction BlockInsertedInSubSystem {
    after element simulink::Block inserted in simulink::SubSystem[subBlocks]
    call createAndRegisterBrakeComponentInSubsystem(affectedEObject, newValue)
}

routine createAndRegisterBrakeComponentInSubsystem(simulink::SubSystem subSystem, simulink::Block block) {
    match {
        val caliper = retrieve brakesystem::BrakeCaliper corresponding to subSystem
        require absence of brakesystem::BrakeComponent corresponding to block
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, BrakeComponent)
        if (existing !== null) {
            addCorrespondenceBetween(block, existing)
        } else {
            createAndRegisterBrakeComponentInSubsystemDirectly(subSystem, block)
        }
    }
}

routine createAndRegisterBrakeComponentInSubsystemDirectly(simulink::SubSystem subSystem, simulink::Block block) {
    match {
        val caliper = retrieve brakesystem::BrakeCaliper corresponding to subSystem
        require absence of brakesystem::BrakeComponent corresponding to block
    }
    create {
        val brakePad = new brakesystem::BrakePad
    }
    update {
        brakePad.id = block.name
        caliper.brakePads += brakePad   
        addCorrespondenceBetween(block, brakePad)
    }
}

reaction BlockNameChanged {
    after attribute replaced at simulink::Block[name]
    call updateBrakeComponentId(affectedEObject, newValue)
}

routine updateBrakeComponentId(simulink::Block block, String newName) {
    match {
        val brakeComponent = retrieve brakesystem::BrakeComponent corresponding to block
    }
    update {
        brakeComponent.id = newName
    }
}

reaction BlockDeleted {
    after element simulink::Block deleted
    call deleteAndUnregisterBrakeComponent(affectedEObject)
}

routine deleteAndUnregisterBrakeComponent(simulink::Block block) {
    match {
        val brakeComponent = retrieve brakesystem::BrakeComponent corresponding to block
    }
    update {
        removeCorrespondenceBetween(block, brakeComponent)
        removeObject(brakeComponent)
    }
}

// Parameters

reaction ParameterInserted {
    after element simulink::Parameter inserted in simulink::Block[parameters]
    call updateAttribute(newValue)
}

reaction ParameterValueChanged {
    after attribute replaced at simulink::Parameter[value]
    call updateAttribute(affectedEObject)
}

routine updateAttribute(simulink::Parameter parameter) {
    match {
        val brakeComponent = retrieve brakesystem::BrakeComponent corresponding to parameter.eContainer()
    }
    update {
        val name = parameter.name
        if (name == "Specification Type" || name == "OEM Number" || name == "Fitting Position") {
            updateBrakeComponent(parameter)
            return
        }

        if (brakeComponent instanceof BrakeDisk) {
            updateBrakeDisk(parameter, brakeComponent)
        } else if (brakeComponent instanceof BrakeHose) {
            updateBrakeHose(parameter, brakeComponent)
        } else if (brakeComponent instanceof ABSSensor) {
            updateABSSensor(parameter, brakeComponent)
        } else if (brakeComponent instanceof BrakeCaliper) {
            updateBrakeCaliper(parameter, brakeComponent)
        } else if (brakeComponent instanceof BrakePad) {
            updateBrakePad(parameter, brakeComponent)
        }
    }
}

routine updateBrakeComponent(simulink::Parameter parameter) {
    match {
        val brakeComponent = retrieve brakesystem::BrakeComponent corresponding to parameter.eContainer()
    }
    update {
        val name = parameter.name
        switch (name) {
            case "Specification Type":
                brakeComponent.specificationType = parameter.value
            case "OEM Number":
                brakeComponent.OEM_number = parameter.value
            case "Fitting Position":
                brakeComponent.fittingPosition = parameter.value
        }
    }
}

// Simulink parameter values are free-form strings (possibly MATLAB expressions).
// Values that cannot be interpreted as the attribute's type are ignored.

routine updateBrakeDisk(simulink::Parameter parameter, brakesystem::BrakeDisk brakeComponent) {
    update {
        if (parameter.name == "Ventilated") {
            val ventilated = ParameterValueUtility.toBoolean(parameter.value)
            if (ventilated !== null) {
                brakeComponent.setVentilated(ventilated)
            }
            return
        }
        val value = ParameterValueUtility.toInteger(parameter.value)
        if (value === null) {
            return
        }
        switch (parameter.name) {
            case "Diameter":
                brakeComponent.setDiameterInMM(value)
            case "Centering Diameter":
                brakeComponent.setCenteringDiameterInMM(value)
            case "Rim Hole Number":
                brakeComponent.setRimHoleNumber(value)
            case "Hole Arrangement Number":
                brakeComponent.setHoleArrangementNumber(value)
            case "Bolt Hole Circle":
                brakeComponent.setBoltHoleCircleInMM(value)
            case "Brake Disk Thickness":
                brakeComponent.setBrakeDiskThicknessInMM(value)
            case "Minimum Thickness":
                brakeComponent.setMinimumThicknessInMM(value)
        }
    }
}

routine updateBrakeCaliper(simulink::Parameter parameter, brakesystem::BrakeCaliper brakeComponent) {
    update {
        val value = ParameterValueUtility.toInteger(parameter.value)
        if (value === null) {
            return
        }
        switch (parameter.name) {
            case "Piston Diameter":
                brakeComponent.setPistonDiameterInMM(value)
            case "Brake Disk Thickness":
                brakeComponent.setBrakeDiskThickness(value)
        }
    }
}

routine updateBrakePad(simulink::Parameter parameter, brakesystem::BrakePad brakeComponent) {
    update {
        if (parameter.name == "Wear Warning") {
            val wearWarning = ParameterValueUtility.toBoolean(parameter.value)
            if (wearWarning !== null) {
                brakeComponent.setWearWarning(wearWarning)
            }
            return
        }
        val value = ParameterValueUtility.toInteger(parameter.value)
        if (value === null) {
            return
        }
        switch (parameter.name) {
            case "Height":
                brakeComponent.setHeightInMM(value)
            case "Width":
                brakeComponent.setWidthInMM(value)
            case "Thickness":
                brakeComponent.setThicknessInMM(value)
        }
    }
}

routine updateBrakeHose(simulink::Parameter parameter, brakesystem::BrakeHose brakeComponent) {
    update {
        switch (parameter.name) {
            case "Thread 1":
                brakeComponent.threadSize1 = parameter.value
            case "Thread 2":
                brakeComponent.threadSize2 = parameter.value
            case "Length": {
                val value = ParameterValueUtility.toInteger(parameter.value)
                if (value !== null) {
                    brakeComponent.setLengthInMM(value)
                }
            }
        }
    }
}

routine updateABSSensor(simulink::Parameter parameter, brakesystem::ABSSensor brakeComponent) {
    update {
        if (parameter.name == "Sensor Type") {
            brakeComponent.sensorType = parameter.value
            return
        }
        val value = ParameterValueUtility.toInteger(parameter.value)
        if (value === null) {
            return
        }
        switch (parameter.name) {
            case "Fitting Depth":
                brakeComponent.setFittingDepth(value)
            case "Number of Pins":
                brakeComponent.setNumberOfPins(value)
            case "Length":
                brakeComponent.setLengthInMM(value)
        }
    }
}
