routine updateCorrespondingAutosarComponentLengthInMM(brakesystem::ABSSensor absSensor, Integer newLengthInMM) {
    match {
        val sensor = retrieve autosar::SensorActuatorSwComponentType corresponding to absSensor
    }
    update {
        updateObjectGeneralInformation(sensor, "lengthInMM", newLengthInMM)
    }
}

routine updateObjectGeneralInformation(autosar::ARObject arObject, String key, plain Object as value) {
    create {
        val nAdminData = new autosar::AdminData
    }
    update {
        var adminData = arObject.adminData
        if (adminData === null) {
            arObject.adminData = nAdminData
            adminData = nAdminData
        }
        updateGeneralInformation(adminData, key, value)
    }
}

reaction ABSSensorDeleted {
    after element brakesystem::ABSSensor deleted
    call deleteCorrespondingAutosarComponent(affectedEObject)
}

routine deleteCorrespondingAutosarComponent(brakesystem::ABSSensor absSensor) {
    match {
        val sensor = retrieve autosar::SensorActuatorSwComponentType corresponding to absSensor
    }
    update {
        removeCorrespondenceBetween(absSensor, sensor)
        removeObject(sensor)
    }
}

// Utility

routine updateGeneralInformation(autosar::AdminData adminData, String key, plain Object as value) {
    create {
        val nsdgGeneralInformation = new autosar::SDG
        val nsd = new autosar::SD
    }
    update {
        var sdgGeneralInformation = adminData.sdgs.findFirst[it.gid == "generalInformation"]
        if (sdgGeneralInformation === null) {
            adminData.sdgs += nsdgGeneralInformation
            sdgGeneralInformation = nsdgGeneralInformation
            sdgGeneralInformation.gid = "generalInformation"
        }
        var sd = sdgGeneralInformation.sd.findFirst[it.key == key]
        if (sd === null) {
            sdgGeneralInformation.sd += nsd
            sd = nsd
            sd.key = key
        }
        sd.value = value
    }
}
