import java.io.File;
import java.lang.Object;

import "http://www.example.org/brakesystem" as brakesystem
import "http://www.example.org/autosar" as autosar

reactions: brakesystem2autosar
in reaction to changes in brakesystem
execute actions in autosar

// Root

reaction BrakesystemInsertedAsRoot {
    after element brakesystem::Brakesystem inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(brakesystem::Brakesystem mBrakesystem) {
    match {
        require absence of autosar::AUTOSAR corresponding to mBrakesystem
    }
    create {
        val mAutosar = new autosar::AUTOSAR
        val adminData = new autosar::AdminData
    }
    update {
        updateGeneralInformation(adminData, "instanceName", mBrakesystem.instanceName)
        updateGeneralInformation(adminData, "specificationType", mBrakesystem.specificationType)

        mAutosar.admindata = adminData

        persistProjectRelative(mBrakesystem, mAutosar, new File("").toString() + "example.autosar")
        addCorrespondenceBetween(mBrakesystem, mAutosar)
    }
}

reaction BrakesystemInstanceNameChanged {
    after attribute replaced at brakesystem::Brakesystem[instanceName]
    call updateAutosarInstanceName(affectedEObject, newValue)
}

routine updateAutosarInstanceName(brakesystem::Brakesystem mBrakesystem, String newInstanceName) {
    match {
        val mAutosar = retrieve autosar::AUTOSAR corresponding to mBrakesystem
    }
    update {
        updateModelGeneralInformation(mBrakesystem, "instanceName", newInstanceName)
    }
}

reaction BrakesystemSpecificationTypeChanged {
    after attribute replaced at brakesystem::Brakesystem[specificationType]
    call updateAutosarSpecificationType(affectedEObject, newValue)
}

routine updateAutosarSpecificationType(brakesystem::Brakesystem mBrakesystem, String newSpecificationType) {
    match {
        val mAutosar = retrieve autosar::AUTOSAR corresponding to mBrakesystem
    }
    update {
        updateModelGeneralInformation(mBrakesystem, "specificationType", newSpecificationType)
    }
}

routine updateModelGeneralInformation(brakesystem::Brakesystem mBrakesystem, String key, plain Object as value) {
    match {
        val mAutosar = retrieve autosar::AUTOSAR corresponding to mBrakesystem
    }
    create {
        val nAdminData = new autosar::AdminData
    }
    update {
        var adminData = mAutosar.admindata
        if (adminData === null) {
            mAutosar.admindata = nAdminData
            adminData = nAdminData
        }
        updateGeneralInformation(adminData, key, value)
    }
}

reaction BrakesystemDeleted {
    after element brakesystem::Brakesystem deleted
    call deleteAndUnregisterRoot(affectedEObject)
}

routine deleteAndUnregisterRoot(brakesystem::Brakesystem mBrakesystem) {
    match {
        val mAutosar = retrieve autosar::AUTOSAR corresponding to mBrakesystem
    }
    update {
        removeCorrespondenceBetween(mBrakesystem, mAutosar)
        removeObject(mAutosar)
    }
}

// ABSSensor

reaction ABSSensorInserted {
    after element brakesystem::ABSSensor inserted in brakesystem::Brakesystem[brakeComponents]
    call createCorrespondingAutosarComponent(newValue)
}

routine createCorrespondingAutosarComponent(brakesystem::ABSSensor absSensor) {
    match {
        val mAutosar = retrieve autosar::AUTOSAR corresponding to absSensor.eContainer()
        require absence of autosar::SensorActuatorSwComponentType corresponding to absSensor
    }
    create {
        val sensor = new autosar::SensorActuatorSwComponentType
        val adminData = new autosar::AdminData
    }
    update {
        if (mAutosar.arpackage.size == 0) {
            createDefaultARPackageIfNotExists(mAutosar)
        }
        val arPackage = mAutosar.arpackage.get(0)
        sensor.shortName = absSensor.id

        updateGeneralInformation(adminData, "specificationType", absSensor.specificationType)
        updateGeneralInformation(adminData, "OEM_number", absSensor.OEM_number)
        updateGeneralInformation(adminData, "fittingPosition", absSensor.fittingPosition)
        updateGeneralInformation(adminData, "sensorType", absSensor.sensorType)
        updateGeneralInformation(adminData, "fittingDepth", absSensor.fittingDepth)
        updateGeneralInformation(adminData, "numberOfPins", absSensor.numberOfPins)
        updateGeneralInformation(adminData, "lengthInMM", absSensor.lengthInMM)

        sensor.adminData = adminData

        arPackage.elements += sensor
        addCorrespondenceBetween(absSensor, sensor)
    }
}

routine createDefaultARPackageIfNotExists(autosar::AUTOSAR mAutosar) {
    create {
        val newPackage = new autosar::ARPackage
    }
    update {
        newPackage.shortName = "DefaultPackage"
        mAutosar.arpackage.add(newPackage)
    }
}

reaction ABSSensorIdChanged {
    after attribute replaced at brakesystem::ABSSensor[id]
    call updateCorrespondingAutosarComponentId(affectedEObject, newValue)
}

routine updateCorrespondingAutosarComponentId(brakesystem::ABSSensor absSensor, String newId) {
    match {
        val sensor = retrieve autosar::SensorActuatorSwComponentType corresponding to absSensor
    }
    update {
        sensor.shortName = newId
    }
}

reaction ABSSensorSpecificationTypeChanged {
    after attribute replaced at brakesystem::ABSSensor[specificationType]
    call updateCorrespondingAutosarComponentSpecificationType(affectedEObject, newValue)
}

routine updateCorrespondingAutosarComponentSpecificationType(brakesystem::ABSSensor absSensor, String newSpecificationType) {
    match {
        val sensor = retrieve autosar::SensorActuatorSwComponentType corresponding to absSensor
    }
    update {
        updateObjectGeneralInformation(sensor, "specificationType", newSpecificationType)
    }
}

