// Utilities

routine updateOrCreateStringParameter(simulink::Block block, String parameterName, String parameterValue) {
    create {
        val newParameter = new simulink::Parameter
    }
    update {
        val parameter = block.parameters.findFirst[it.name == parameterName]
        if (parameter !== null) {
            parameter.value = parameterValue
        } else {
            newParameter.name = parameterName
            newParameter.value = parameterValue
            newParameter.type = "string"
            block.parameters.add(newParameter)
        }
    }
}

routine updateOrCreateBooleanParameter(simulink::Block block, String parameterName, Boolean parameterValue) {
    create {
        val newParameter = new simulink::Parameter
    }
    update {
        val parameter = block.parameters.findFirst[it.name == parameterName]
        if (parameter !== null) {
            parameter.value = parameterValue.toString()
        } else {
            newParameter.name = parameterName
            newParameter.value = parameterValue.toString()
            newParameter.type = "boolean"
            block.parameters.add(newParameter)
        }
    }
}

routine updateOrCreateIntegerParameter(simulink::Block block, String parameterName, Integer parameterValue) {
    create {
        val newParameter = new simulink::Parameter
    }
    update {
        val parameter = block.parameters.findFirst[it.name == parameterName]
        if (parameter !== null) {
            parameter.value = parameterValue.toString()
        } else {
            newParameter.name = parameterName
            newParameter.value = parameterValue.toString()
            newParameter.type = "int32"
            block.parameters.add(newParameter)
        }
    }
}
