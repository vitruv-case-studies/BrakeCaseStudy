import java.io.File;
import java.util.Arrays;
import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality;

import brakesystem.BrakeCaliper;
import brakesystem.BrakePad;

import "http://www.example.org/simulink" as simulink
import "http://www.example.org/brakesystem" as brakesystem

reactions: brakesystem2simulink
in reaction to changes in brakesystem
execute actions in simulink

// Root

reaction BrakesystemInsertedAsRoot {
    after element brakesystem::Brakesystem inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(brakesystem::Brakesystem model) {
    match {
        require absence of simulink::SimulinkModel corresponding to model
    }
    create {
        val mSimulink = new simulink::SimulinkModel
    }
    update {
        mSimulink.name = model.instanceName

        persistProjectRelative(model, mSimulink, new File("").toString() + "example.simulink")
        addCorrespondenceBetween(model, mSimulink)
    }
}

reaction BrakesystemInstanceNameChanged {
    after attribute replaced at brakesystem::Brakesystem[instanceName]
    call updateSimulinkModelName(affectedEObject, newValue)
}

routine updateSimulinkModelName(brakesystem::Brakesystem model, String newName) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to model
    }
    update {
        mSimulink.name = newName
    }
}

reaction BrakesystemDeletedAsRoot {
    after element brakesystem::Brakesystem deleted
    call deleteAndUnregisterRoot(affectedEObject)
}

routine deleteAndUnregisterRoot(brakesystem::Brakesystem model) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to model
    }
    update {
        removeCorrespondenceBetween(model, mSimulink)
        removeObject(mSimulink)
    }
}

// Break Component

reaction BrakeComponentInserted {
    after element brakesystem::BrakeComponent inserted in brakesystem::Brakesystem[brakeComponents]
    call createCorrespondingSimulinkBlock(newValue)
}

routine createCorrespondingSimulinkBlock(brakesystem::BrakeComponent brakeComponent) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to brakeComponent.eContainer()
        require absence of simulink::Block corresponding to brakeComponent
    }
    update {
        createSimulinkBlockOrSubSystem(brakeComponent, mSimulink)
    }
}

routine createSimulinkBlockOrSubSystem(brakesystem::BrakeComponent brakeComponent, simulink::SimulinkModel model) {
    update {
        var createSubSystem = false
        if (brakeComponent instanceof BrakeCaliper) {
            createSubSystem = true
        } else if (brakeComponent instanceof BrakePad) {
            createSubSystem = false
        }
        else {
            val chosen = userInteractor.singleSelectionDialogBuilder.message(
                "Should the Brake Component by a Simulink Block or SubSystem?").choices(
                    Arrays.asList("Block", "SubSystem")).windowModality(WindowModality.MODAL).startInteraction
            createSubSystem = chosen == 1
        }
        if (createSubSystem) {
            createSimulinkSubSystem(brakeComponent, model)
        } else {
            createSimulinkBlock(brakeComponent, model)
        }
    }
}

routine createSimulinkSubSystem(brakesystem::BrakeComponent brakeComponent, simulink::SimulinkModel model) {
    create {
        val subSystem = new simulink::SubSystem
    }
    update {
        subSystem.name = brakeComponent.id
        model.contains.add(subSystem)
        addCorrespondenceBetween(brakeComponent, subSystem)
    }
}

routine createSimulinkBlock(brakesystem::BrakeComponent brakeComponent, simulink::SimulinkModel model) {
    create {
        val block = new simulink::Block
    }
    update {
        block.name = brakeComponent.id
        model.contains.add(block)
        addCorrespondenceBetween(brakeComponent, block)
    }
}

reaction BrakePadInserted {
    after element brakesystem::BrakePad inserted in brakesystem::BrakeCaliper[brakePads]
    call createSimulinkBlockForBrakePad(affectedEObject, newValue)
}

routine createSimulinkBlockForBrakePad(brakesystem::BrakeCaliper brakeCaliper, brakesystem::BrakePad brakePad) {
    match {
        val mSimulink = retrieve simulink::SimulinkModel corresponding to brakePad.eContainer().eContainer()
        val subSystem = retrieve simulink::SubSystem corresponding to brakeCaliper
        require absence of simulink::Block corresponding to brakePad
    }
    create {
        val block = new simulink::Block
    }
    update {
        block.name = brakePad.id
        subSystem.subBlocks.add(block)
        addCorrespondenceBetween(brakePad, block)
    }
}

reaction BrakeComponentIdChanged {
    after attribute replaced at brakesystem::BrakeComponent[id]
    call updateSimulinkBlockName(affectedEObject, newValue)
}

routine updateSimulinkBlockName(brakesystem::BrakeComponent brakeComponent, String newId) {
    match {
        val block = retrieve simulink::Block corresponding to brakeComponent
    }
    update {
        block.name = newId
    }
}

reaction BrakeComponentDeleted {
    after element brakesystem::BrakeComponent deleted
    call deleteCorrespondingSimulinkBlock(affectedEObject)
}

routine deleteCorrespondingSimulinkBlock(brakesystem::BrakeComponent brakeComponent) {
    match {
        val block = retrieve simulink::Block corresponding to brakeComponent
    }
    update {
        removeCorrespondenceBetween(brakeComponent, block)
        removeObject(block)
    }
}

