import java.util.Objects

import bom.NumericParameterValue
import edu.kit.ipd.sdq.metamodels.cad.Assembly
import edu.kit.ipd.sdq.metamodels.cad.CADDocument
import edu.kit.ipd.sdq.metamodels.cad.Constraint
import edu.kit.ipd.sdq.metamodels.cad.ConstraintType
import tools.vitruv.casestudies.brakesystem.consistency.BomUtility
import tools.vitruv.casestudies.brakesystem.consistency.CadUtility
import tools.vitruv.casestudies.brakesystem.consistency.MeasurementUnit
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility

import "http://example.org/bom" as bom
import "http://demonstrator.kit.edu/cad" as cad

reactions: bom2cad
in reaction to changes in bom
execute actions in cad

reaction BOMInsertedAsRoot {
    after element bom::BOM inserted as root
    call createCADDocument(newValue)
}

routine createCADDocument(bom::BOM source) {
    match {
        require absence of cad::CADDocument corresponding to source
    }
    update {
        // Another model may already have created the CAD document; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, source, CADDocument)
        if (existing !== null) {
            addCorrespondenceBetween(source, existing)
        } else {
            createCADDocumentDirectly(source)
        }
    }
}

routine createCADDocumentDirectly(bom::BOM source) {
    match {
        require absence of cad::CADDocument corresponding to source
    }
    create {
        val target = new cad::CADDocument
    }
    update {
        target.name = source.name
        persistProjectRelative(source, target, "example.cad")
        addCorrespondenceBetween(source, target)
    }
}

reaction BOMNameChanged {
    after attribute replaced at bom::BOM[name]
    call updateCADDocumentName(affectedEObject)
}

routine updateCADDocumentName(bom::BOM source) {
    match {
        val target = retrieve cad::CADDocument corresponding to source
    }
    update {
        if (!Objects.equals(target.name, source.name)) target.name = source.name
    }
}

// Every item is a physical part with a CAD part (an Assembly, see CadUtility) per instance: an
// item with quantity n corresponds to the parts named "id", "id-2", ..., "id-n". The BOM is flat,
// so new parts are placed at the top level of the document; other models may nest them.
reaction ItemInserted {
    after element bom::Item inserted in bom::BOM[items]
    call synchronizeParts(newValue)
}

reaction NumberOfItemsChanged {
    after attribute replaced at bom::Item[numberOfItems]
    call synchronizeParts(affectedEObject)
}

routine synchronizeParts(bom::Item item) {
    match {
        val document = retrieve cad::CADDocument corresponding to item.eContainer()
    }
    update {
        val desired = Math.max(0, item.numberOfItems)
        // The instances with the highest index are removed, so all models remove the same instances
        val parts = TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, item, Assembly)
        for (part : BomUtility.instancesToRemove(parts, [name], item.id, desired)) {
            removeCorrespondenceBetween(item, part)
            removeObject(part)
        }
        var count = TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, item, Assembly).size
        while (count < desired) {
            // Instances created by other models for this item (e.g. for its brake components) are reused
            val existing = TransitiveCorrespondenceUtility.findFurtherTransitivelyCorresponding(executionState.correspondenceModel, item, Assembly)
            if (existing !== null) {
                addCorrespondenceBetween(item, existing)
                for (value : item.parameterValues) linkOrCreateParameter(value, existing)
            } else {
                val usedIds = TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, item, Assembly).map[name]
                createPart(item, document, BomUtility.freeInstanceId(item.id, usedIds))
            }
            count = count + 1
        }
    }
}

// Like for brake components and Simulink blocks, the label of a part is the instance name
routine createPart(bom::Item item, cad::CADDocument document, String id) {
    update {
        val part = CadUtility.createPart(id, id)
        document.objects.add(part)
        addCorrespondenceBetween(item, part)
        for (value : item.parameterValues) linkOrCreateParameter(value, part)
    }
}

// The identifiers of the instances are derived from the item, so they are renamed with it.
// Renaming by the old identifier keeps the index of every instance, so all models agree.
reaction ItemIdChanged {
    after attribute replaced at bom::Item[id]
    call updatePartNames(affectedEObject, oldValue)
}

routine updatePartNames(bom::Item item, String oldId) {
    update {
        for (part : TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, item, Assembly)) {
            val newId = BomUtility.renamedInstanceId(oldId, item.id, part.name)
            if (newId !== null && !Objects.equals(part.name, newId)) {
                if (Objects.equals(part.label, part.name)) part.label = newId
                CadUtility.renamePart(part, newId)
            }
        }
    }
}

//
//// Parameter values
//
// Only numeric values with a dimension are part of the overlap: lengths become named constraints
// in metres, angles (unit "deg") in degrees. Texts, flags and counts have no counterpart in CAD.

reaction ParameterValueInserted {
    after element bom::ParameterValue inserted in bom::Item[parameterValues]
    call createParameters(newValue)
}

routine createParameters(bom::ParameterValue value) {
    update {
        for (part : TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, value.eContainer(), Assembly)) {
            linkOrCreateParameter(value, part)
        }
    }
}

// Parameters are identified by their name: a constraint that already exists in the part
// (e.g. created from the brake system) is linked instead of creating a second one
routine linkOrCreateParameter(bom::ParameterValue value, cad::Assembly part) {
    update {
        if (value.definition === null || !(value instanceof NumericParameterValue)) {
            return
        }
        val numeric = value as NumericParameterValue
        val unit = BomUtility.cadUnitOf(numeric)
        if (unit === null) {
            return
        }
        val existing = CadUtility.findParameter(part, value.definition.name)
        if (existing !== null) {
            if (!getCorrespondingElements(value, Constraint, null, null).contains(existing)) {
                addCorrespondenceBetween(value, existing)
            }
            updateParameter(numeric, existing)
        } else {
            val type = if (unit == MeasurementUnit.DEG) ConstraintType.ANGLE else CadUtility.defaultTypeFor(value.definition.name)
            val parameter = CadUtility.createParameter(part, value.definition.name, type, BomUtility.toCadValue(numeric, unit))
            addCorrespondenceBetween(value, parameter)
        }
    }
}

reaction IntegerValueChanged {
    after attribute replaced at bom::IntegerParameterValue[value]
    call updateParameters(affectedEObject)
}
reaction DoubleValueChanged {
    after attribute replaced at bom::DoubleParameterValue[value]
    call updateParameters(affectedEObject)
}
reaction NumericUnitChanged {
    after attribute replaced at bom::NumericParameterValue[unit]
    call updateParameters(affectedEObject)
}

routine updateParameters(bom::NumericParameterValue value) {
    update {
        for (parameter : TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, value, Constraint)) {
            updateParameter(value, parameter)
        }
    }
}

// Numbers are written in the unit of the constraint. Values that already represent the BOM
// value are not rewritten, so a propagated change does not overwrite the user's precision.
routine updateParameter(bom::NumericParameterValue value, cad::Constraint parameter) {
    update {
        val unit = CadUtility.unitOf(parameter)
        if (!BomUtility.representsCadValue(value, parameter.value, unit)) {
            CadUtility.setValue(parameter, BomUtility.toCadValue(value, unit))
        }
    }
}

reaction ParameterValueDeleted {
    after element bom::ParameterValue deleted
    call deleteParameters(affectedEObject)
}

routine deleteParameters(bom::ParameterValue value) {
    update {
        for (parameter : TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, value, Constraint)) {
            removeCorrespondenceBetween(value, parameter)
            CadUtility.removeParameter(parameter)
        }
    }
}

reaction ItemDeleted {
    after element bom::Item deleted
    call deleteParts(affectedEObject)
}

routine deleteParts(bom::Item item) {
    update {
        for (part : TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, item, Assembly)) {
            removeCorrespondenceBetween(item, part)
            removeObject(part)
        }
    }
}
