import java.util.Arrays;
import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality;

import simulink.SubSystem;
import autosar.AUTOSAR;
import autosar.SDG;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import autosar.SwComponentType;
import brakesystem.BrakeComponent;
import brakesystem.ABSSensor;
import autosar.ARPackage;
import org.eclipse.emf.ecore.util.EcoreUtil;

import "http://www.example.org/simulink" as simulink
import "http://www.example.org/autosar" as autosar

reactions: simulink2autosar
in reaction to changes in simulink
execute actions in autosar

// Root Reactions
reaction SimulinkModelInsertedAsRoot {
    after element simulink::SimulinkModel inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(simulink::SimulinkModel model) {
    match {
        require absence of autosar::AUTOSAR corresponding to model
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, model, AUTOSAR)
        if (existing !== null) {
            addCorrespondenceBetween(model, existing)
        } else {
            createRoot(model)
        }
    }
}

routine createRoot(simulink::SimulinkModel model) {
    match {
        require absence of autosar::AUTOSAR corresponding to model
    }
    create {
        val mAutosar = new autosar::AUTOSAR
    }
    update {
        persistProjectRelative(model, mAutosar, "example.autosar")
        addCorrespondenceBetween(model, mAutosar)
    }
}

reaction SimulinkModelDeletedAsRoot {
    after element simulink::SimulinkModel deleted
    call deleteAndUnregisterRoot(affectedEObject)
}

routine deleteAndUnregisterRoot(simulink::SimulinkModel model) {
    match {
        val mAutosar = retrieve autosar::AUTOSAR corresponding to model
    }
    update {
        removeCorrespondenceBetween(model, mAutosar)
        removeObject(mAutosar)
    }
}

// Block Reactions
reaction SimulinkBlockInserted {
    after element simulink::Block inserted in simulink::SimulinkModel[contains]
    call createCorrespondingAutoSarComponent(newValue)
}

routine createCorrespondingAutoSarComponent(simulink::Block block) {
    match {
        val mAutosarModel = retrieve autosar::AUTOSAR corresponding to block.eContainer()
        require absence of autosar::SwComponentType corresponding to block
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, SwComponentType)
        if (existing !== null) {
            addCorrespondenceBetween(block, existing)
        } else {
            createCorrespondingAutoSarComponentDirectly(block)
        }
    }
}

routine createCorrespondingAutoSarComponentDirectly(simulink::Block block) {
    match {
        val mAutosarModel = retrieve autosar::AUTOSAR corresponding to block.eContainer()
        require absence of autosar::SwComponentType corresponding to block
    }
    update {
        createCorrespondingAutoSarComponentForBlock(mAutosarModel, block)
    }
}

routine createCorrespondingAutoSarComponentForBlock(autosar::AUTOSAR model, simulink::Block block) {
    update {
        // The brake system already decides whether the block is a sensor (ABSSensor <-> SensorActuatorSwComponentType),
        // so the user cannot give a contradicting answer here
        val brakeComponent = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, BrakeComponent)
        if (brakeComponent instanceof ABSSensor) {
            createSensorActuatorSwComponentType(model, block)
        } else if (block instanceof SubSystem) {
            createCompositionSwComponentType(model, block)
        } else {
            val choices = newArrayList("ApplicationSwComponentType", "ServiceProxySwComponentType", "EcuAbstractionSwComponentType",
                "ComplexDeviceDriverSwComponentType", "NvBlockSwComponentType", "ServiceSwComponentType")
            if (brakeComponent === null) {
                choices += "SensorActuatorSwComponentType"
            }
            val componentType = userInteractor.singleSelectionDialogBuilder.message(
                "What AutoSAR component do you want to add to be correspondent to this block?").choices(
                choices).windowModality(WindowModality.MODAL).startInteraction
            switch (componentType) {
                case 0:
                    createApplicationSwComponentType(model, block)
                case 1:
                    createServiceProxySwComponentType(model, block)
                case 2:
                    createEcuAbstractionSwComponentType(model, block)
                case 3:
                    createComplexDeviceDriverSwComponentType(model, block)
                case 4:
                    createNvBlockSwComponentType(model, block)
                case 5:
                    createServiceSwComponentType(model, block)
                case 6:
                    createSensorActuatorSwComponentType(model, block)
            }
        }
    }
}

routine createCompositionSwComponentType(autosar::AUTOSAR model, simulink::SubSystem subsystem) {
    create {
        val component = new autosar::CompositionSwComponentType
    }
    update {
        initializeAutoSarComponent(model, component, subsystem)
    }
}

routine createApplicationSwComponentType(autosar::AUTOSAR model, simulink::Block block) {
    create {
        val component = new autosar::ApplicationSwComponentType
    }
    update {
        initializeAutoSarComponent(model, component, block)
    }
}

routine createServiceProxySwComponentType(autosar::AUTOSAR model, simulink::Block block) {
    create {
        val component = new autosar::ServiceProxySwComponentType
    }
    update {
        initializeAutoSarComponent(model, component, block)
    }
}

routine createEcuAbstractionSwComponentType(autosar::AUTOSAR model, simulink::Block block) {
    create {
        val component = new autosar::EcuAbstractionSwComponentType
    }
    update {
        initializeAutoSarComponent(model, component, block)
    }
}

routine createComplexDeviceDriverSwComponentType(autosar::AUTOSAR model, simulink::Block block) {
    create {
        val component = new autosar::ComplexDeviceDriverSwComponentType
    }
    update {
        initializeAutoSarComponent(model, component, block)
    }
}

routine createNvBlockSwComponentType(autosar::AUTOSAR model, simulink::Block block) {
    create {
        val component = new autosar::NvBlockSwComponentType
    }
    update {
        initializeAutoSarComponent(model, component, block)
    }
}

routine createServiceSwComponentType(autosar::AUTOSAR model, simulink::Block block) {
    create {
        val component = new autosar::ServiceSwComponentType
    }
    update {
        initializeAutoSarComponent(model, component, block)
    }
}

routine createSensorActuatorSwComponentType(autosar::AUTOSAR model, simulink::Block block) {
    create {
        val component = new autosar::SensorActuatorSwComponentType
    }
    update {
        initializeAutoSarComponent(model, component, block)
    }
}

routine initializeAutoSarComponent(autosar::AUTOSAR model, autosar::SwComponentType component, simulink::Block block) {
    update {
        if (model.arpackage.size == 0) {
            createDefaultARPackageIfNotExists(model)
        }
        val mARPackage = model.arpackage.get(0)
        component.shortName = block.name
        mARPackage.elements.add(component)
        addCorrespondenceBetween(block, component)
    }
}

routine createDefaultARPackageIfNotExists(autosar::AUTOSAR mAutosarModel) {
    create {
        val newPackage = new autosar::ARPackage
    }
    update {
        newPackage.setShortName("DefaultPackage")
        mAutosarModel.arpackage.add(newPackage)
    }
}

reaction SimulinkBlockInsertedInSubsystem {
    after element simulink::Block inserted in simulink::SubSystem[subBlocks]
    call insertCorrespondingComponent(affectedEObject, newValue)
}

routine insertCorrespondingComponent(simulink::SubSystem parentSubsystem, simulink::Block block) {
    match {
        val parentComposition = retrieve autosar::CompositionSwComponentType corresponding to parentSubsystem
        val component = retrieve autosar::SwComponentType corresponding to block
    }
    create {
        val prototype = new autosar::SwComponentPrototype
    }
    update {
        if (parentComposition.getComponents().findFirst[p | p.type === component] === null) {
            prototype.type = component
            parentComposition.getComponents().add(prototype)
        }
    }
}

reaction SimulinkBlockCreatedAndInsertedInSubsystem {
    after element simulink::Block inserted in simulink::SubSystem[subBlocks]
    call createAndInsertCorrespondingComponent(affectedEObject, newValue)
}

routine createAndInsertCorrespondingComponent(simulink::SubSystem parentSubsystem, simulink::Block block) {
    match {
        val parentComposition = retrieve autosar::CompositionSwComponentType corresponding to parentSubsystem
        require absence of autosar::SwComponentType corresponding to block
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, SwComponentType)
        if (existing !== null) {
            addCorrespondenceBetween(block, existing)
            insertCorrespondingComponent(parentSubsystem, block)
        } else {
            createAndInsertCorrespondingComponentDirectly(parentSubsystem, block)
        }
    }
}

routine createAndInsertCorrespondingComponentDirectly(simulink::SubSystem parentSubsystem, simulink::Block block) {
    match {
        val parentComposition = retrieve autosar::CompositionSwComponentType corresponding to parentSubsystem
        require absence of autosar::SwComponentType corresponding to block
    }
    update {
        // The composition may be in any (sub-)package
        val mAutosarModel = EcoreUtil.getRootContainer(parentComposition)
        if (mAutosarModel instanceof AUTOSAR) {
            createCorrespondingAutoSarComponentForBlock(mAutosarModel, block)
            insertCorrespondingComponent(parentSubsystem, block)
        }
    }
}

reaction SimulinkBlockRemovedFromSubsystem {
    after element simulink::Block removed from simulink::SubSystem[subBlocks]
    call removeComponent(affectedEObject, oldValue)
}

routine removeComponent(simulink::SubSystem parentSubsystem, simulink::Block block) {
    match {
        val parentComposition = retrieve autosar::CompositionSwComponentType corresponding to parentSubsystem
        val component = retrieve autosar::SwComponentType corresponding to block
    }
    update {
        val prototype = parentComposition.getComponents().findFirst[p | p.type === component]
        if (prototype !== null) {
            parentComposition.getComponents().remove(prototype)
        }
    }
}

reaction SimulinkBlockDeleted {
    after element simulink::Block deleted
    call deleteComponent(affectedEObject)
}

routine deleteComponent(simulink::Block block) {
    match {
        val component = retrieve autosar::SwComponentType corresponding to block
    }
    update {
        // Remove the component from the package it actually is in, not just the first package
        val mARPackage = component.eContainer()
        if (mARPackage instanceof ARPackage) {
            mARPackage.elements.remove(component)
        }
        removeCorrespondenceBetween(block, component)
    }
}

reaction SimulinkBlockNameChanged {
    after attribute replaced at simulink::Block[name]
    call updateComponentName(affectedEObject, newValue)
}

routine updateComponentName(simulink::Block block, String newName) {
    match {
        val component = retrieve autosar::SwComponentType corresponding to block
    }
    update {
        component.shortName = newName
    }
}
