import java.io.File;

import autosar.AUTOSAR;
import autosar.SDG;
import autosar.SensorActuatorSwComponentType;

import "http://www.example.org/brakesystem" as brakesystem
import "http://www.example.org/autosar" as autosar

reactions: autosar2brakesystem
in reaction to changes in autosar
execute actions in brakesystem

// Root 

reaction AutosarInsertedAsRoot {
    after element autosar::AUTOSAR inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(autosar::AUTOSAR mAutosar) {
    match {
        require absence of brakesystem::Brakesystem corresponding to mAutosar
    }
    create {
        val mBrakesystem = new brakesystem::Brakesystem
    }
    update {
        if (mAutosar.admindata !== null) {
            val generalInformation = mAutosar.admindata.sdgs.findFirst[it.gid == "generalInformation"]
            if (generalInformation !== null) {
                val instanceName = generalInformation.sd.findFirst[it.key == "instanceName"]
                if (instanceName !== null) {
                    mBrakesystem.instanceName = instanceName.value as String
                }
                val specificationType = generalInformation.sd.findFirst[it.key == "specificationType"]
                if (specificationType !== null) {
                    mBrakesystem.specificationType = specificationType.value as String
                }
            }
        }

        persistProjectRelative(mAutosar, mBrakesystem, new File("").toString() + "example.brakesystem")
        addCorrespondenceBetween(mAutosar, mBrakesystem)
    }
}

reaction AutosarDeletedAsRoot {
    after element autosar::AUTOSAR deleted
    call deleteAndUnregisterRoot(affectedEObject)
}

routine deleteAndUnregisterRoot(autosar::AUTOSAR mAutosar) {
    match {
        val mBrakesystem = retrieve brakesystem::Brakesystem corresponding to mAutosar
    }
    update {
        removeCorrespondenceBetween(mAutosar, mBrakesystem)
        removeObject(mBrakesystem)
    }
}

// SensorActuatorSwComponentType

reaction SensorActuatorSwComponentTypeInserted {
    after element autosar::SensorActuatorSwComponentType inserted in autosar::ARPackage[elements]
    call createCorrespondingBrakesystemElement(newValue)
}

routine createCorrespondingBrakesystemElement(autosar::SensorActuatorSwComponentType component) {
    match {
        val mBrakesystem = retrieve brakesystem::Brakesystem corresponding to component.eContainer().eContainer()
        require absence of brakesystem::ABSSensor corresponding to component
    }
    create {
        val absSensor = new brakesystem::ABSSensor
    }
    update {
        absSensor.id = component.shortName

        if (component.adminData !== null) {
            val generalInformation = component.adminData.sdgs.findFirst[it.gid == "generalInformation"]
            if (generalInformation !== null) {
                val specificationType = generalInformation.sd.findFirst[it.key == "specificationType"]
                if (specificationType !== null) {
                    absSensor.specificationType = specificationType.value as String
                }
                val OEM_number = generalInformation.sd.findFirst[it.key == "OEM_number"]
                if (OEM_number !== null) {
                    absSensor.OEM_number = OEM_number.value as String
                }
                val fittingPosition = generalInformation.sd.findFirst[it.key == "fittingPosition"]
                if (fittingPosition !== null) {
                    absSensor.fittingPosition = fittingPosition.value as String
                }
                val sensorType = generalInformation.sd.findFirst[it.key == "sensorType"]
                if (sensorType !== null) {
                    absSensor.sensorType = sensorType.value as String
                }
                val fittingDepth = generalInformation.sd.findFirst[it.key == "fittingDepth"]
                if (fittingDepth !== null) {
                    absSensor.fittingDepth = fittingDepth.value as Integer
                }
                val numberOfPins = generalInformation.sd.findFirst[it.key == "numberOfPins"]
                if (numberOfPins !== null) {
                    absSensor.numberOfPins = numberOfPins.value as Integer
                }
                val lengthInMM = generalInformation.sd.findFirst[it.key == "lengthInMM"]
                if (lengthInMM !== null) {
                    absSensor.lengthInMM = lengthInMM.value as Integer
                }
            }
        }

        mBrakesystem.brakeComponents += absSensor
        addCorrespondenceBetween(component, absSensor)
    }
}

reaction SensorActuatorSwComponentShortNameChanged {
    after attribute replaced at autosar::SensorActuatorSwComponentType[shortName]
    call updateCorrespondingSensorId(affectedEObject, newValue)
}

routine updateCorrespondingSensorId(autosar::SensorActuatorSwComponentType component, String newShortName) {
    match {
        val absSensor = retrieve brakesystem::ABSSensor corresponding to component
    }
    update {
        absSensor.id = newShortName
    }
}

reaction SensorActuatorSwComponentTypeDeleted {
    after element autosar::SensorActuatorSwComponentType deleted
    call deleteCorrespondingBrakesystemElement(affectedEObject)
}

routine deleteCorrespondingBrakesystemElement(autosar::SensorActuatorSwComponentType component) {
    match {
        val absSensor = retrieve brakesystem::ABSSensor corresponding to component
    }
    update {
        removeCorrespondenceBetween(component, absSensor)
        removeObject(absSensor)
    }
}

// SDG

reaction SDGInserted {
    after element autosar::SD inserted in autosar::SDG[sd]
    call updateCorrespondingBrakesystemElement(newValue)
}

reaction SDGValueChanged {
    after attribute replaced at autosar::SD[value]
    call updateCorrespondingBrakesystemElement(affectedEObject)
}

routine updateCorrespondingBrakesystemElement(autosar::SD sd) {
    update {
        if (sd.eContainer().eContainer().eContainer() instanceof AUTOSAR) {
            updateCorrespondingBrakesystemRoot(sd)
        } else if (sd.eContainer().eContainer().eContainer() instanceof SensorActuatorSwComponentType) {
            updateCorrespondingBrakesystemSensor(sd)
        }
    }
}

routine updateCorrespondingBrakesystemRoot(autosar::SD sd) {
    match {
        val mBrakesystem = retrieve brakesystem::Brakesystem corresponding to sd.eContainer().eContainer().eContainer()
    }
    update {
        val sdg = sd.eContainer() as SDG
        if (sdg.gid == "generalInformation") {
            switch (sd.key) {
                case "instanceName":
                    mBrakesystem.instanceName = sd.value as String
                case "specificationType":
                    mBrakesystem.specificationType = sd.value as String
                default:
                    return
            }
        }
    }
}

routine updateCorrespondingBrakesystemSensor(autosar::SD sd) {
    match {
        val absSensor = retrieve brakesystem::ABSSensor corresponding to sd.eContainer().eContainer().eContainer()
    }
    update {
        val sdg = sd.eContainer() as SDG
        if (sdg.gid == "generalInformation") {
            switch (sd.key) {
                case "specificationType":
                    absSensor.specificationType = sd.value as String
                case "OEM_number":
                    absSensor.OEM_number = sd.value as String
                case "fittingPosition":
                    absSensor.fittingPosition = sd.value as String
                case "sensorType":
                    absSensor.sensorType = sd.value as String
                case "fittingDepth":
                    absSensor.fittingDepth = sd.value as Integer
                case "numberOfPins":
                    absSensor.numberOfPins = sd.value as Integer
                case "lengthInMM":
                    absSensor.lengthInMM = sd.value as Integer
                default:
                    return
            }
        }
    }
}
