import java.util.Objects

import bom.BOM
import bom.DataType
import bom.Item
import bom.NumericParameterValue
import brakesystem.BrakeComponent
import edu.kit.ipd.sdq.metamodels.cad.Assembly
import edu.kit.ipd.sdq.metamodels.cad.Constraint
import tools.vitruv.casestudies.brakesystem.consistency.BomUtility
import tools.vitruv.casestudies.brakesystem.consistency.CadUtility
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility

import "http://demonstrator.kit.edu/cad" as cad
import "http://example.org/bom" as bom

reactions: cad2bom
in reaction to changes in cad
execute actions in bom

reaction CADDocumentInsertedAsRoot {
    after element cad::CADDocument inserted as root
    call createBOM(newValue)
}

routine createBOM(cad::CADDocument source) {
    match {
        require absence of bom::BOM corresponding to source
    }
    update {
        // Another model may already have created the BOM; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, source, BOM)
        if (existing !== null) {
            addCorrespondenceBetween(source, existing)
        } else {
            createBOMDirectly(source)
        }
    }
}

routine createBOMDirectly(cad::CADDocument source) {
    match {
        require absence of bom::BOM corresponding to source
    }
    create {
        val target = new bom::BOM
    }
    update {
        target.name = source.name
        persistProjectRelative(source, target, "example.bom")
        addCorrespondenceBetween(source, target)
    }
}

reaction CADDocumentNameChanged {
    after attribute replaced at cad::CADDocument[name]
    call updateBOMName(affectedEObject)
}

routine updateBOMName(cad::CADDocument source) {
    match {
        val target = retrieve bom::BOM corresponding to source
    }
    update {
        if (!Objects.equals(target.name, source.name)) target.name = source.name
    }
}

// Every part of the CAD document (an Assembly, see CadUtility), also a nested one, is a physical
// part and is therefore listed in the BOM. Like the brake components and Simulink blocks, a part
// describes one instance: its name is the instance name, not the kind of the part.
reaction PartInsertedInDocument {
    after element cad::Assembly inserted in cad::CADDocument[objects]
    call createItem(newValue)
}

reaction PartInsertedInPart {
    after element cad::Assembly inserted in cad::Assembly[children]
    call createItem(newValue)
}

routine createItem(cad::Assembly part) {
    match {
        val target = retrieve bom::BOM corresponding to CadUtility.documentOf(part)
        require absence of bom::Item corresponding to part
    }
    update {
        // The item may already exist via another model, e.g. for the brake component of the part.
        // An item can count several parts, so it may already correspond to other parts.
        val existing = TransitiveCorrespondenceUtility.findSharedTransitivelyCorresponding(executionState.correspondenceModel, part, Item)
        if (existing !== null) {
            addCorrespondenceBetween(part, existing)
        } else {
            createItemDirectly(part)
        }
        for (parameter : CadUtility.parameters(part)) createParameterValue(parameter)
    }
}

routine createItemDirectly(cad::Assembly part) {
    match {
        val target = retrieve bom::BOM corresponding to CadUtility.documentOf(part)
        require absence of bom::Item corresponding to part
    }
    create {
        val item = new bom::Item
    }
    update {
        // The brake system decides the kind of brake components (also later, see brakesystem2bom).
        // Until then, or for other parts, the item is an unclassified "Part" that can be classified in the BOM.
        val component = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, part, BrakeComponent)
        val kind = if (component !== null) component.eClass.name else null
        item.type = BomUtility.findOrCreateItemType(target, kind)
        item.id = part.name
        item.numberOfItems = 1
        target.items.add(item)
        addCorrespondenceBetween(part, item)
    }
}

// An item may count several parts. Only an item of a single part takes over its
// identifier; otherwise the identifiers of the instances are derived from the item.
reaction PartNameChanged {
    after attribute replaced at cad::Assembly[name]
    call updateItemId(affectedEObject)
}

routine updateItemId(cad::Assembly part) {
    match {
        val item = retrieve bom::Item corresponding to part
    }
    update {
        if (item.numberOfItems == 1 && !Objects.equals(item.id, part.name)) item.id = part.name
    }
}

//
//// Parameters (named dimensional constraints, see CadUtility)
//

reaction ParameterInserted {
    after element cad::Constraint inserted in cad::Sketch[constraints]
    call createParameterValue(newValue)
}

reaction ParameterSketchInserted {
    after element cad::Sketch inserted in cad::Assembly[children]
    call createParameterValues(newValue)
}

routine createParameterValues(cad::Sketch sketch) {
    update {
        for (constraint : sketch.constraints) createParameterValue(constraint)
    }
}

// A constraint becomes a parameter once it is named (or gets a dimensional type)
reaction ParameterNameChanged {
    after attribute replaced at cad::Constraint[name]
    call createOrUpdateParameterValue(affectedEObject)
}

reaction ParameterTypeChanged {
    after attribute replaced at cad::Constraint[type]
    call createOrUpdateParameterValue(affectedEObject)
}

reaction ParameterValueChanged {
    after attribute replaced at cad::Constraint[value]
    call updateParameterValue(affectedEObject)
}

routine createOrUpdateParameterValue(cad::Constraint parameter) {
    update {
        createParameterValue(parameter)
        updateParameterValue(parameter)
    }
}

// Parameters are identified by their name. The item may already have the value, e.g. from the
// brake system or from another instance of the item, so it is reused. CAD values are numbers.
routine createParameterValue(cad::Constraint parameter) {
    match {
        require absence of bom::ParameterValue corresponding to parameter
    }
    update {
        if (!CadUtility.isParameter(parameter)) {
            return
        }
        createParameterValueOfPart(parameter, CadUtility.partOf(parameter))
    }
}

routine createParameterValueOfPart(cad::Constraint parameter, cad::Assembly part) {
    match {
        val item = retrieve bom::Item corresponding to part
        require absence of bom::ParameterValue corresponding to parameter
    }
    update {
        if (item.type === null) {
            return
        }
        val value = BomUtility.findOrCreateValue(item, parameter.name, DataType.EDOUBLE)
        addCorrespondenceBetween(parameter, value)
        updateParameterValue(parameter)
    }
}

// Numbers are written in the unit of the BOM value (see BomUtility). Parameter names are the
// keys of the values and shared by all items of a type, so renaming a CAD constraint is not
// propagated to the BOM.
routine updateParameterValue(cad::Constraint parameter) {
    match {
        val value = retrieve bom::ParameterValue corresponding to parameter
    }
    update {
        if (CadUtility.isParameter(parameter) && value instanceof NumericParameterValue) {
            BomUtility.setFromCad(value as NumericParameterValue, parameter.value, CadUtility.unitOf(parameter))
        }
    }
}

reaction ParameterDeleted {
    after element cad::Constraint deleted
    call deleteParameterValue(affectedEObject)
}

// A value corresponds to the parameter of every instance of the item; it is only deleted with the last one
routine deleteParameterValue(cad::Constraint parameter) {
    match {
        val value = retrieve bom::ParameterValue corresponding to parameter
    }
    update {
        removeCorrespondenceBetween(parameter, value)
        if (TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, value, Constraint).empty) {
            removeObject(value)
        }
    }
}

reaction PartDeleted {
    after element cad::Assembly deleted
    call deleteItem(affectedEObject)
}

routine deleteItem(cad::Assembly part) {
    match {
        val item = retrieve bom::Item corresponding to part
    }
    update {
        removeCorrespondenceBetween(part, item)
        // Other parts of the item may have been deleted in the same change, so only live ones count
        val remaining = TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, item, Assembly).size
        if (remaining == 0) {
            removeObject(item)
        } else if (item.numberOfItems != remaining) {
            item.numberOfItems = remaining
        }
    }
}
