    call synchronizeParameters(affectedEObject)
}

// The parameter names are the ones used for CAD and Simulink as well. Lengths are written in
// millimetres, but values that already represent the attribute in another unit are kept.
// Attributes that were never set are not listed (see BomUtility).
routine synchronizeParameters(brakesystem::BrakeComponent component) {
    match {
        val item = retrieve bom::Item corresponding to component
    }
    update {
        if (BomUtility.isListed(item, "Specification Type", component, "specificationType")) BomUtility.putString(item, "Specification Type", component.specificationType)
        if (BomUtility.isListed(item, "OEM Number", component, "OEM_number")) BomUtility.putString(item, "OEM Number", component.OEM_number)
        if (BomUtility.isListed(item, "Fitting Position", component, "fittingPosition")) BomUtility.putString(item, "Fitting Position", component.fittingPosition)
        if (component instanceof ABSSensor) {
            if (BomUtility.isListed(item, "Sensor Type", component, "sensorType")) BomUtility.putString(item, "Sensor Type", component.sensorType)
            if (BomUtility.isListed(item, "Fitting Depth", component, "fittingDepth")) BomUtility.putLength(item, "Fitting Depth", component.fittingDepth)
            if (BomUtility.isListed(item, "Number of Pins", component, "numberOfPins")) BomUtility.putCount(item, "Number of Pins", component.numberOfPins)
            if (BomUtility.isListed(item, "Length", component, "lengthInMM")) BomUtility.putLength(item, "Length", component.lengthInMM)
        } else if (component instanceof BrakeCaliper) {
            if (BomUtility.isListed(item, "Piston Diameter", component, "pistonDiameterInMM")) BomUtility.putLength(item, "Piston Diameter", component.pistonDiameterInMM)
            if (BomUtility.isListed(item, "Brake Disk Thickness", component, "brakeDiskThickness")) BomUtility.putLength(item, "Brake Disk Thickness", component.brakeDiskThickness)
        } else if (component instanceof BrakeHose) {
            if (BomUtility.isListed(item, "Thread 1", component, "threadSize1")) BomUtility.putString(item, "Thread 1", component.threadSize1)
            if (BomUtility.isListed(item, "Thread 2", component, "threadSize2")) BomUtility.putString(item, "Thread 2", component.threadSize2)
            if (BomUtility.isListed(item, "Length", component, "lengthInMM")) BomUtility.putLength(item, "Length", component.lengthInMM)
        } else if (component instanceof BrakeDisk) {
            if (BomUtility.isListed(item, "Diameter", component, "diameterInMM")) BomUtility.putLength(item, "Diameter", component.diameterInMM)
            if (BomUtility.isListed(item, "Centering Diameter", component, "centeringDiameterInMM")) BomUtility.putLength(item, "Centering Diameter", component.centeringDiameterInMM)
            if (BomUtility.isListed(item, "Rim Hole Number", component, "rimHoleNumber")) BomUtility.putCount(item, "Rim Hole Number", component.rimHoleNumber)
            if (BomUtility.isListed(item, "Hole Arrangement Number", component, "holeArrangementNumber")) BomUtility.putCount(item, "Hole Arrangement Number", component.holeArrangementNumber)
            if (BomUtility.isListed(item, "Bolt Hole Circle", component, "boltHoleCircleInMM")) BomUtility.putLength(item, "Bolt Hole Circle", component.boltHoleCircleInMM)
            if (BomUtility.isListed(item, "Brake Disk Thickness", component, "brakeDiskThicknessInMM")) BomUtility.putLength(item, "Brake Disk Thickness", component.brakeDiskThicknessInMM)
            if (BomUtility.isListed(item, "Minimum Thickness", component, "minimumThicknessInMM")) BomUtility.putLength(item, "Minimum Thickness", component.minimumThicknessInMM)
            if (BomUtility.isListed(item, "Ventilated", component, "ventilated")) BomUtility.putBoolean(item, "Ventilated", component.ventilated)
        } else if (component instanceof BrakePad) {
            if (BomUtility.isListed(item, "Height", component, "heightInMM")) BomUtility.putLength(item, "Height", component.heightInMM)
            if (BomUtility.isListed(item, "Width", component, "widthInMM")) BomUtility.putLength(item, "Width", component.widthInMM)
            if (BomUtility.isListed(item, "Thickness", component, "thicknessInMM")) BomUtility.putLength(item, "Thickness", component.thicknessInMM)
            if (BomUtility.isListed(item, "Wear Warning", component, "wearWarning")) BomUtility.putBoolean(item, "Wear Warning", component.wearWarning)
        }
    }
}

reaction BrakeComponentDeleted {
    after element brakesystem::BrakeComponent deleted
    call deleteBOMItemOrDecreaseQuantity(affectedEObject)
}

routine deleteBOMItemOrDecreaseQuantity(brakesystem::BrakeComponent component) {
    match {
        val item = retrieve bom::Item corresponding to component
    }
    update {
        removeCorrespondenceBetween(component, item)
        // Other components of the item may have been deleted in the same change, so only live ones count
        val remaining = TransitiveCorrespondenceUtility.getLiveCorresponding(executionState.correspondenceModel, item, BrakeComponent).size
        if (remaining == 0) {
            removeObject(item)
        } else if (item.numberOfItems != remaining) {
            item.numberOfItems = remaining
        }
    }
}
