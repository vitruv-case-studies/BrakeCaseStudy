import java.io.File;
import java.util.Arrays;
import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality;

import edu.kit.ipd.sdq.metamodels.cad.Unit;
import edu.kit.ipd.sdq.metamodels.cad.StringParameter;
import edu.kit.ipd.sdq.metamodels.cad.NumericParameter;
import edu.kit.ipd.sdq.metamodels.cad.BooleanParameter;

import autosar.AUTOSAR;
import autosar.SDG;

import "http://www.example.org/cad" as cad
import "http://www.example.org/autosar" as autosar

reactions: autosar2cad
in reaction to changes in autosar
execute actions in cad

// Root

reaction AutosarInsertedAsRoot {
    after element autosar::AUTOSAR inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(autosar::AUTOSAR mAutosar) {
    match {
        require absence of cad::CAD_Model corresponding to mAutosar
    }
    create {
        val mCad = new cad::CAD_Model
    }
    update {
        if (mAutosar.arpackage.size() > 0) {
            mCad.name = mAutosar.arpackage.get(0).shortName
        }

        persistProjectRelative(mAutosar, mCad, new File("").toString() + "example.cad")
        addCorrespondenceBetween(mAutosar, mCad)
    }
}

reaction AutosarDeletedAsRoot {
    after element autosar::AUTOSAR deleted
    call deleteAndUnregisterRoot(affectedEObject)
}

routine deleteAndUnregisterRoot(autosar::AUTOSAR mAutosar) {
    match {
        val mCad = retrieve cad::CAD_Model corresponding to mAutosar
    }
    update {
        removeCorrespondenceBetween(mAutosar, mCad)
        removeObject(mCad)
    }
}

// arPackage

reaction RootPackageInserted {
    after element autosar::ARPackage inserted in autosar::AUTOSAR[arpackage]
    call updateCadName(newValue)
}

reaction RootPackageShortNameChanged {
    after attribute replaced at autosar::ARPackage[shortName]
    call updateCadName(affectedEObject)
}

routine updateCadName(autosar::ARPackage rootPackage) {
    match {
        val mCad = retrieve cad::CAD_Model corresponding to rootPackage.eContainer()
    }
    update {
        val mAutosar = rootPackage.eContainer() as AUTOSAR
        if (mAutosar.arpackage.get(0) == rootPackage) {
            mCad.name = rootPackage.shortName
        }
    }
}

reaction PackageInserted {
    after element autosar::ARPackage inserted in autosar::ARPackage[subPackages]
    call createCorrespondingNamespace(newValue)
}

routine createCorrespondingNamespace(autosar::ARPackage arPackage) {
    match {
        val mCad = retrieve cad::CAD_Model corresponding to arPackage.eContainer().eContainer()
        require absence of cad::Namespace corresponding to arPackage
    }
    create {
        val namespace = new cad::Namespace
    }
    update {
        namespace.name = arPackage.shortName

        if (arPackage.adminData !== null) {
            val cadNamespace = arPackage.adminData.sdgs.findFirst[it.gid == "cadNamespace"]
            if (cadNamespace !== null) {
                val cadNamespaceId = cadNamespace.sd.findFirst[it.key == "cadNamespaceId"]
                if (cadNamespaceId !== null) {
                    namespace.id = cadNamespaceId.value as String
                }
            }
        }

        addCorrespondenceBetween(arPackage, namespace)
        mCad.namespaces.add(namespace)
    }
}

reaction PackageShortNameChanged {
    after attribute replaced at autosar::ARPackage[shortName]
    call updateCorrespondingNamespaceName(affectedEObject)
}

routine updateCorrespondingNamespaceName(autosar::ARPackage arPackage) {
    match {
        val namespace = retrieve cad::Namespace corresponding to arPackage
    }
    update {
        namespace.name = arPackage.shortName
    }
}

reaction PackageDeleted {
    after element autosar::ARPackage deleted
    call deleteCorrespondingNamespace(affectedEObject)
}

routine deleteCorrespondingNamespace(autosar::ARPackage arPackage) {
    match {
        val namespace = retrieve cad::Namespace corresponding to arPackage
    }
    update {
        removeCorrespondenceBetween(arPackage, namespace)
        removeObject(namespace)
    }
}

// SDG
        
reaction SDGInserted {
    after element autosar::SDG inserted in autosar::AdminData[sdgs]
    with newValue.gid != "cadNamespace"
    call createCorrespondingParameter(newValue)
}

routine createCorrespondingParameter(autosar::SDG sdg) {
    match {
        val namespace = retrieve cad::Namespace corresponding to sdg.eContainer().eContainer()
        require absence of cad::Parameter corresponding to sdg
    }
    update {
        var String typeString = null
        val type = sdg.sd.findFirst[it.key == "type"]
        if (type !== null) {
            typeString = type.value as String
        }
        if (typeString === null) {
            val chosen = userInteractor.singleSelectionDialogBuilder.message(
                "What is the type of the parameter corresponding to this SDG?").choices(
                Arrays.asList("NumericParameter", "StringParameter", "BooleanParameter")).windowModality(WindowModality.MODAL).startInteraction
            switch (chosen) {
                case 0:
                    typeString = "string"
                case 1:
                    typeString = "float"
                case 2:
                    typeString = "boolean"
            }
        }
        switch (typeString) {
            case "string":
                createStringParameter(namespace, sdg)
            case "float":
                createNumericParameter(namespace, sdg)
            case "boolean":
                createBooleanParameter(namespace, sdg)
        }
    }
}

routine createStringParameter(cad::Namespace namespace, autosar::SDG sdg) {
    create {
        val parameter = new cad::StringParameter
    }
    update {
        initializeParameter(namespace, parameter, sdg)
        val value = sdg.sd.findFirst[it.key == "value"]
        if (value !== null) {
            parameter.value = value.value as String
        }
        val unit = sdg.sd.findFirst[it.key == "unit"]
        if (unit !== null) {
            parameter.unit = unit.value as Unit
        }
    }
}

routine createNumericParameter(cad::Namespace namespace, autosar::SDG sdg) {
    create {
        val parameter = new cad::NumericParameter
    }
    update {
        initializeParameter(namespace, parameter, sdg)
        val value = sdg.sd.findFirst[it.key == "value"]
        if (value !== null) {
            parameter.value = value.value as Float
        }
        val unit = sdg.sd.findFirst[it.key == "unit"]
        if (unit !== null) {
            parameter.unit = unit.value as Unit
        }
    }
}

routine createBooleanParameter(cad::Namespace namespace, autosar::SDG sdg) {
    create {
        val parameter = new cad::BooleanParameter
    }
    update {
        initializeParameter(namespace, parameter, sdg)
        val value = sdg.sd.findFirst[it.key == "value"]
        if (value !== null) {
            parameter.value = value.value as Boolean
        }
    }
}

routine initializeParameter(cad::Namespace namespace, cad::Parameter parameter, autosar::SDG sdg) {
    update {
        parameter.id = sdg.gid as String

        val name = sdg.sd.findFirst[it.key == "name"]
        if (name !== null) {
            parameter.name = name.value as String
        }
        val description = sdg.sd.findFirst[it.key == "description"]
        if (description !== null) {
            parameter.description = description.value as String
        }

        namespace.parameters.add(parameter)
        addCorrespondenceBetween(sdg, parameter)
    }
}

reaction SDGGidChanged {
    after attribute replaced at autosar::SDG[gid]
    call updateCorrespondingParameterId(affectedEObject)
}
routine updateCorrespondingParameterId(autosar::SDG sdg) {
    match {
        val parameter = retrieve cad::Parameter corresponding to sdg
    }
    update {
        parameter.id = sdg.gid as String
    }
}

reaction SDDeleted {
    after element autosar::SDG deleted
    call deleteCorrespondingParameter(affectedEObject)
}

routine deleteCorrespondingParameter(autosar::SDG sdg) {
    match {
        val parameter = retrieve cad::Parameter corresponding to sdg
    }
    update {
        removeCorrespondenceBetween(sdg, parameter)
        removeObject(parameter)
    }
}

// SD

reaction SDInserted {
    after element autosar::SD inserted in autosar::SDG[sd]
    call {
        updateCorrespondingNamespace(newValue)
        updateCorrespondingParameter(newValue)
    }
}

reaction SDValueChanged {
    after attribute replaced at autosar::SD[value]
    call {
        updateCorrespondingNamespace(affectedEObject)
        updateCorrespondingParameter(affectedEObject)
    }
}

routine updateCorrespondingNamespace(autosar::SD sd) {
    match {
        val namespace = retrieve cad::Namespace corresponding to sd.eContainer().eContainer()
    }
    update {
        val sdg = sd.eContainer() as SDG
        if (sdg.gid == "cadNamespace") {
            switch (sd.key) {
                case "cadNamespaceId":
                    namespace.id = sd.value as String
            }
        }
    }
}

routine updateCorrespondingParameter(autosar::SD sd) {
    match {
        val parameter = retrieve cad::Parameter corresponding to sd.eContainer().eContainer()
    }
    update {
        val sdg = sd.eContainer() as SDG
        if (sdg.gid == parameter.id) {
            switch (sd.key) {
                case "name":
                    parameter.name = sd.value as String
                case "description":
                    parameter.description = sd.value as String
                case "id":
                    parameter.id = sd.value as String
                case "value":
                    if (parameter instanceof StringParameter) {
                        parameter.value = sd.value as String
                    } else if (parameter instanceof NumericParameter) {
                        parameter.value = sd.value as Float
                    } else if (parameter instanceof BooleanParameter) {
                        parameter.value = sd.value as Boolean
                    }
                case "unit":
                    if (parameter instanceof StringParameter) {
                        parameter.unit = sd.value as Unit
                    } else if (parameter instanceof NumericParameter) {
                        parameter.unit = sd.value as Unit
                    }
            }
        }
    }
}
