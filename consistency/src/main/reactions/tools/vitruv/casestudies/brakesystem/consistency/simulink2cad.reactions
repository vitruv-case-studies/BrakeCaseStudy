import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality
import java.util.Arrays

import edu.kit.ipd.sdq.metamodels.cad.Assembly;
import edu.kit.ipd.sdq.metamodels.cad.CADDocument;
import edu.kit.ipd.sdq.metamodels.cad.Constraint;
import edu.kit.ipd.sdq.metamodels.cad.ConstraintType;

import tools.vitruv.casestudies.brakesystem.consistency.CadUtility;
import tools.vitruv.casestudies.brakesystem.consistency.MeasurementUnit;
import tools.vitruv.casestudies.brakesystem.consistency.ParameterValueUtility;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import brakesystem.BrakeComponent;
import bom.Item;

import "http://www.example.org/simulink" as simulink
import "http://demonstrator.kit.edu/cad" as cad

// A Simulink block of a physical part corresponds to a part of the CAD document, i.e. an Assembly
// (see CadUtility). The block name is the name and label of a new part; later renamings only change
// the label. A block in a subsystem is a part nested in the subsystem's part. Only dimensions are
// part of the overlap: numeric parameters (lengths in millimetres) are named constraints in metres.
// Texts, flags and counts have no counterpart in CAD.

reactions: simulink2cad
in reaction to changes in simulink
execute actions in cad

// Insertion Reactions
reaction SimulinkModelInsertedAsRoot {
    after element simulink::SimulinkModel inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(simulink::SimulinkModel model) {
    match {
        require absence of cad::CADDocument corresponding to model
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, model, CADDocument)
        if (existing !== null) {
            addCorrespondenceBetween(model, existing)
        } else {
            createRoot(model)
        }
    }
}

routine createRoot(simulink::SimulinkModel model) {
    match {
        require absence of cad::CADDocument corresponding to model
    }
    create {
        val mCad = new cad::CADDocument
    }
    update {
        mCad.name = model.name
        persistProjectRelative(model, mCad, "example.cad")
        addCorrespondenceBetween(model, mCad)
    }
}

reaction SimulinkBlockInserted {
    after element simulink::Block inserted in simulink::SimulinkModel[contains]
    call createOrPlacePart(newValue, null)
}

reaction SimulinkBlockInsertedInSubSystem {
    after element simulink::Block inserted in simulink::SubSystem[subBlocks]
    call createOrPlacePart(newValue, affectedEObject)
}

// A block that already has a part was moved: the part follows into the part of the new subsystem,
// or to the top level of the document. Subsystems without a part (e.g. software) leave it in place.
routine createOrPlacePart(simulink::Block block, simulink::SubSystem subSystem) {
    update {
        val part = getCorrespondingElements(block, Assembly, null, null).head
        val parentPart = if (subSystem !== null) getCorrespondingElements(subSystem, Assembly, null, null).head
        if (part !== null) {
            val document = CadUtility.documentOf(part)
            if (document !== null && (subSystem === null || parentPart !== null)) {
                CadUtility.placePart(part, parentPart, document)
            }
        } else if (subSystem === null) {
            createCADPart(block)
        } else if (parentPart !== null) {
            createCADPartInSubSystem(subSystem, block)
        }
    }
}

routine createCADPart(simulink::Block block) {
    match {
        val mCad = retrieve cad::CADDocument corresponding to block.eContainer()
        require absence of cad::Assembly corresponding to block
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, Assembly)
        if (existing !== null) {
            addCorrespondenceBetween(block, existing)
        } else if (
                // CAD only describes physical parts. Brake components and parts listed in the BOM are physical;
                // for other blocks (e.g. software or further hardware) the user decides.
                TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, BrakeComponent) !== null ||
                TransitiveCorrespondenceUtility.findSharedTransitivelyCorresponding(executionState.correspondenceModel, block, Item) !== null ||
                userInteractor.confirmationDialogBuilder.message(
                    "Does the Simulink block '" + block.name + "' represent a physical part? Only physical parts get a CAD part.").
                    windowModality(WindowModality.MODAL).startInteraction) {
            createCADPartDirectly(block, null, mCad)
        }
    }
}

routine createCADPartInSubSystem(simulink::SubSystem subSystem, simulink::Block block) {
    match {
        val mParentPart = retrieve cad::Assembly corresponding to subSystem
        require absence of cad::Assembly corresponding to block
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, Assembly)
        if (existing !== null) {
            addCorrespondenceBetween(block, existing)
            CadUtility.placePart(existing, mParentPart, CadUtility.documentOf(mParentPart))
        } else if (
                // CAD only describes physical parts. Brake components and parts listed in the BOM are physical;
                // for other blocks (e.g. software or further hardware) the user decides.
                TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, block, BrakeComponent) !== null ||
                TransitiveCorrespondenceUtility.findSharedTransitivelyCorresponding(executionState.correspondenceModel, block, Item) !== null ||
                userInteractor.confirmationDialogBuilder.message(
                    "Does the Simulink block '" + block.name + "' represent a physical part? Only physical parts get a CAD part.").
                    windowModality(WindowModality.MODAL).startInteraction) {
            createCADPartDirectly(block, mParentPart, CadUtility.documentOf(mParentPart))
        }
    }
}

routine createCADPartDirectly(simulink::Block block, cad::Assembly mParentPart, cad::CADDocument mCad) {
    match {
        require absence of cad::Assembly corresponding to block
    }
    update {
        val part = CadUtility.createPart(block.name, block.name)
        CadUtility.placePart(part, mParentPart, mCad)
        addCorrespondenceBetween(block, part)
        // Parameters may have been added together with the block
        for (parameter : block.parameters) createCADParameter(parameter)
    }
}

reaction ParameterInserted {
    after element simulink::Parameter inserted in simulink::Block[parameters]
    call createCADParameter(newValue)
}

routine createCADParameter(simulink::Parameter parameter) {
    match {
        val mPart = retrieve cad::Assembly corresponding to parameter.eContainer()
        require absence of cad::Constraint corresponding to parameter
    }
    update {
        // A dimension with the same name may already have been created via the brake system model
        val sameName = CadUtility.findParameter(mPart, parameter.name)
        if (sameName !== null && !TransitiveCorrespondenceUtility.hasDirectlyCorresponding(executionState.correspondenceModel, sameName, typeof(simulink.Parameter))) {
            addCorrespondenceBetween(parameter, sameName)
            return
        }
        if (parameter.name === null || CadUtility.isCount(parameter.name)) {
            return
        }

        var ConstraintType constraintType = null
        if (parameter.type === null) {
            val choice = userInteractor.singleSelectionDialogBuilder.message(
                "Which CAD dimension does the parameter '" + parameter.name + "' describe?").choices(
                Arrays.asList("length (in mm)","angle (in degrees)","none")).windowModality(WindowModality.MODAL).
                startInteraction
            switch (choice) {
                case 0:
                    constraintType = CadUtility.defaultTypeFor(parameter.name)
                case 1:
                    constraintType = ConstraintType.ANGLE
                default:
                    return // Do nothing
            }
        } else {
            switch (parameter.type) {
                case "double",
                case "single",
                case "half",
                case "uint8",
                case "int8",
                case "uint16",
                case "int16",
                case "uint32",
                case "int32",
                case "uint64",
                case "int64":
                    constraintType = CadUtility.defaultTypeFor(parameter.name)
                default:
                    return // Texts and flags have no counterpart in CAD
            }
        }
        // Values that are not numeric (e.g. MATLAB expressions) are left at zero
        val number = ParameterValueUtility.toFloat(parameter.value)
        val unit = if (constraintType == ConstraintType.ANGLE) MeasurementUnit.DEG else MeasurementUnit.M
        val value = if (number !== null) ParameterValueUtility.simulinkToCadValue(number.doubleValue, unit) else 0.0
        val constraint = CadUtility.createParameter(mPart, parameter.name, constraintType, value)
        addCorrespondenceBetween(parameter, constraint)
    }
}


// Deletion Reactions

reaction SimuLinkBlockDeleted {
    after element simulink::Block deleted
    call deleteCADPart(affectedEObject)
}

routine deleteCADPart(simulink::Block block) {
    match {
        val mPart = retrieve cad::Assembly corresponding to block
    }
    update {
        removeObject(mPart)
        removeCorrespondenceBetween(block, mPart)
    }
}

reaction ParameterDeleted {
    after element simulink::Parameter deleted
    call deleteCADParameter(affectedEObject)
}

routine deleteCADParameter(simulink::Parameter parameter) {
    match {
        val constraint = retrieve cad::Constraint corresponding to parameter
    }
    update {
        removeCorrespondenceBetween(parameter, constraint)
        CadUtility.removeParameter(constraint)
    }
}

// Update Reactions

reaction SimulinkModelNameUpdated {
    after attribute replaced at simulink::SimulinkModel[name]
    call updateCADDocumentName(affectedEObject, newValue)
}

routine updateCADDocumentName(simulink::SimulinkModel model, String newName) {
    match {
        val mCad = retrieve cad::CADDocument corresponding to model
    }
    update {
        mCad.name = newName
    }
}

reaction SimulinkBlockNameUpdated {
    after attribute replaced at simulink::Block[name]
    call updateCADPartLabel(affectedEObject, newValue)
}

routine updateCADPartLabel(simulink::Block block, String newName) {
    match {
        val mPart = retrieve cad::Assembly corresponding to block
    }
    update {
        if (mPart.label != newName) mPart.label = newName
    }
}


reaction SimulinkParameterNameUpdated {
    after attribute replaced at simulink::Parameter[name]
    call updateCADParameterName(affectedEObject, newValue)
}

routine updateCADParameterName(simulink::Parameter parameter, String newName) {
    match {
        val constraint = retrieve cad::Constraint corresponding to parameter
    }
    update {
        if (constraint.name != newName) constraint.name = newName
    }
}


reaction SimulinkParameterValueUpdated {
    after attribute replaced at simulink::Parameter[value]
    call updateCADParameterValue(affectedEObject)
}

// Simulink holds lengths in millimetres; values that are not numeric are ignored
routine updateCADParameterValue(simulink::Parameter parameter) {
    match {
        val constraint = retrieve cad::Constraint corresponding to parameter
    }
    update {
        val number = ParameterValueUtility.toFloat(parameter.value)
        if (number === null) {
            return
        }
        val value = ParameterValueUtility.simulinkToCadValue(number.doubleValue, CadUtility.unitOf(constraint))
        if (!ParameterValueUtility.denotesNumber(parameter.value, ParameterValueUtility.cadToSimulinkValue(constraint.value, CadUtility.unitOf(constraint)))) {
            CadUtility.setValue(constraint, value)
        }
    }
}
