
import edu.kit.ipd.sdq.metamodels.cad.Unit;
import edu.kit.ipd.sdq.metamodels.cad.StringParameter;
import edu.kit.ipd.sdq.metamodels.cad.NumericParameter;
import edu.kit.ipd.sdq.metamodels.cad.BooleanParameter;

import tools.vitruv.casestudies.brakesystem.consistency.ParameterValueUtility;
import edu.kit.ipd.sdq.metamodels.cad.CAD_Model;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import edu.kit.ipd.sdq.metamodels.cad.Namespace;


import "http://www.example.org/brakesystem" as brakesystem
import "http://www.example.org/cad" as cad

reactions: brakesystem2cad
in reaction to changes in brakesystem
execute actions in cad

reaction BrakesystemInsertedAsRoot {
    after element brakesystem::Brakesystem inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(brakesystem::Brakesystem repo) {
    match {
        require absence of cad::CAD_Model corresponding to repo
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, repo, CAD_Model)
        if (existing !== null) {
            addCorrespondenceBetween(repo, existing)
        } else {
            createRoot(repo)
        }
    }
}

routine createRoot(brakesystem::Brakesystem repo) {
    match {
        require absence of cad::CAD_Model corresponding to repo
    }
    create {
        val mCad = new cad::CAD_Model
    }
    update {
        persistProjectRelative(repo, mCad, "example.cad")
        addCorrespondenceBetween(repo, mCad)
    }
}

reaction BrakesystemDeleted {
    after element brakesystem::Brakesystem deleted
    call deleteCorrespondingCADModel(affectedEObject)
}

routine deleteCorrespondingCADModel(brakesystem::Brakesystem repo) {
    match {
        val mCad = retrieve cad::CAD_Model corresponding to repo
    }
    update {
        removeObject(mCad)
        removeCorrespondenceBetween(repo, mCad)
    }
}

//
//// Brake Component
//
reaction BrakeComponentInserted {
    after element brakesystem::BrakeComponent inserted in brakesystem::Brakesystem[brakeComponents]
    call createAndRegisterBrakeComponent(newValue)
}

routine createAndRegisterBrakeComponent(brakesystem::BrakeComponent component) {
    match {
        val mCad = retrieve cad::CAD_Model corresponding to component.eContainer()
        require absence of cad::Namespace corresponding to component
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, component, Namespace)
        if (existing !== null) {
            addCorrespondenceBetween(component, existing)
        } else {
            createAndRegisterBrakeComponentDirectly(component)
        }
    }
}

routine createAndRegisterBrakeComponentDirectly(brakesystem::BrakeComponent component) {
    match {
        val mCad = retrieve cad::CAD_Model corresponding to component.eContainer()
        require absence of cad::Namespace corresponding to component
    }
    update {
        createAndRegisterNamespaceForBrakeComponent(mCad, component)
    }
}

reaction BrakePadInsertedInCaliper {
    after element brakesystem::BrakePad inserted in brakesystem::BrakeCaliper[brakePads]
    call createAndRegisterBrakePad(newValue)
}

routine createAndRegisterBrakePad(brakesystem::BrakePad pad) {
    match {
        val mCad = retrieve cad::CAD_Model corresponding to pad.eContainer().eContainer()
        require absence of cad::Namespace corresponding to pad
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, pad, Namespace)
        if (existing !== null) {
            addCorrespondenceBetween(pad, existing)
        } else {
            createAndRegisterBrakePadDirectly(pad)
        }
    }
}

routine createAndRegisterBrakePadDirectly(brakesystem::BrakePad pad) {
    match {
        val mCad = retrieve cad::CAD_Model corresponding to pad.eContainer().eContainer()
        require absence of cad::Namespace corresponding to pad
    }
    update {
        createAndRegisterNamespaceForBrakeComponent(mCad, pad)
    }
}

routine createAndRegisterNamespaceForBrakeComponent(cad::CAD_Model cadModel, brakesystem::BrakeComponent component) {
    create {
        val namespace = new cad::Namespace 
    }
    update {
        namespace.id = component.id
        cadModel.namespaces.add(namespace)
        addCorrespondenceBetween(component, namespace)
    }
}

// Parameter changes

reaction SpecificationTypeChanged {
    after attribute replaced at brakesystem::BrakeComponent[specificationType]
    call updateSpecificationType(affectedEObject)
}

reaction OEMNumberChanged {
    after attribute replaced at brakesystem::BrakeComponent[OEM_number]
    call updateOEMNumber(affectedEObject)
}

reaction FittingPositionChanged {
    after attribute replaced at brakesystem::BrakeComponent[fittingPosition]
    call updateFittingPosition(affectedEObject)
}

reaction IdChanged {
    after attribute replaced at brakesystem::BrakeComponent[id]
    call updateId(affectedEObject)
}

routine updateSpecificationType(brakesystem::BrakeComponent comp) {
    match {
        val namespace = retrieve cad::Namespace corresponding to comp
    }
    create {
        val stringParameter = new cad::StringParameter
    }
    update {
        var pSpecificationType = namespace.parameters.findFirst[p | p.name == "Specification Type" && p instanceof StringParameter] as StringParameter
        if (pSpecificationType === null) {
            pSpecificationType = stringParameter
            pSpecificationType.name = "Specification Type"
            namespace.parameters.add(pSpecificationType)
        }
        pSpecificationType.setValue(comp.specificationType)
    }
}

routine updateOEMNumber(brakesystem::BrakeComponent comp) {
    match {
        val namespace = retrieve cad::Namespace corresponding to comp
    }
    create {
        val stringParameter = new cad::StringParameter
    }
    update {
        var pOEM_Number = namespace.parameters.findFirst[p | p.name == "OEM Number" && p instanceof StringParameter] as StringParameter
        if (pOEM_Number === null) {
            pOEM_Number = stringParameter
            pOEM_Number.name = "OEM Number"
            namespace.parameters.add(pOEM_Number)
        }
        pOEM_Number.setValue(comp.OEM_number)
    }
}

routine updateFittingPosition(brakesystem::BrakeComponent comp) {
    match {
        val namespace = retrieve cad::Namespace corresponding to comp
    }
    create {
        val stringParameter = new cad::StringParameter
    }
    update {
        var pFittingPosition = namespace.parameters.findFirst[p | p.name == "Fitting Position" && p instanceof StringParameter] as StringParameter
        if (pFittingPosition === null) {
            pFittingPosition = stringParameter
            pFittingPosition.name = "Fitting Position"
            namespace.parameters.add(pFittingPosition)
        }
        pFittingPosition.setValue(comp.fittingPosition)
    }
}

routine updateId(brakesystem::BrakeComponent comp) {
    match {
        val namespace = retrieve cad::Namespace corresponding to comp
    }
    update {
        namespace.id = comp.id
    }
}


