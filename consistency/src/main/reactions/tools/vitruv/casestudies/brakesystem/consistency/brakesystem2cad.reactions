        if (pFittingDepth === null) {
            pFittingDepth = numericParameter
            pFittingDepth.name = "Fitting Depth"
            pFittingDepth.unit = Unit.MM
            namespace.parameters.add(pFittingDepth)
        } 
        if (!ParameterValueUtility.isLengthUnit(pFittingDepth.unit)) {
            pFittingDepth.unit = Unit.MM
        }
        if (!ParameterValueUtility.representsMillimetres(pFittingDepth.value, pFittingDepth.unit, sensor.fittingDepth)) {
            pFittingDepth.setValue(ParameterValueUtility.fromMillimetres(sensor.fittingDepth, pFittingDepth.unit))
        }
        
    }
}

routine updateNumberOfPins(brakesystem::ABSSensor sensor) {
    match {
        val namespace = retrieve cad::Namespace corresponding to sensor
    }
    create {
        val numericParameter = new cad::NumericParameter 
    }
    update {
        var pNumberOfPins = namespace.parameters.findFirst[p | p.name == "Number of Pins" && p instanceof NumericParameter] as NumericParameter
        if (pNumberOfPins === null) {
            pNumberOfPins = numericParameter
            pNumberOfPins.name = "Number of Pins"
            pNumberOfPins.unit = Unit.COUNT
            namespace.parameters.add(pNumberOfPins)
        }
        pNumberOfPins.setValue(sensor.numberOfPins)
    }
}

routine updateLength(brakesystem::ABSSensor sensor) {
    match {
        val namespace = retrieve cad::Namespace corresponding to sensor
    }
    create {
        val numericParameter = new cad::NumericParameter 
    }
    update {
        var pLength = namespace.parameters.findFirst[p | p.name == "Length" && p instanceof NumericParameter] as NumericParameter
        if (pLength === null) {
            pLength = numericParameter
            pLength.name = "Length"
            pLength.unit = Unit.MM
            namespace.parameters.add(pLength)
        }
        if (!ParameterValueUtility.isLengthUnit(pLength.unit)) {
            pLength.unit = Unit.MM
        }
        if (!ParameterValueUtility.representsMillimetres(pLength.value, pLength.unit, sensor.lengthInMM)) {
            pLength.setValue(ParameterValueUtility.fromMillimetres(sensor.lengthInMM, pLength.unit))
        }
    }
}
