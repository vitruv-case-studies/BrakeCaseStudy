routine updateDiameter(brakesystem::BrakeDisk disk) {
    match {
        val namespace = retrieve cad::Namespace corresponding to disk
    }
    create {
        val numericParameter = new cad::NumericParameter
    }   
    update {
        var pDiameter = namespace.parameters.findFirst[p | p.name == "Diameter" && p instanceof NumericParameter] as NumericParameter
        if (pDiameter === null) {
            pDiameter = numericParameter
            pDiameter.name = "Diameter"
            pDiameter.unit = Unit.MM
            namespace.parameters.add(pDiameter)
        }
        if (!ParameterValueUtility.isLengthUnit(pDiameter.unit)) {
            pDiameter.unit = Unit.MM
        }
        if (!ParameterValueUtility.representsMillimetres(pDiameter.value, pDiameter.unit, disk.diameterInMM)) {
            pDiameter.setValue(ParameterValueUtility.fromMillimetres(disk.diameterInMM, pDiameter.unit))
        }
    }
}

