
import edu.kit.ipd.sdq.metamodels.cad.Assembly;
import edu.kit.ipd.sdq.metamodels.cad.CADDocument;

import tools.vitruv.casestudies.brakesystem.consistency.CadUtility;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import brakesystem.ABSSensor;
import brakesystem.BrakeCaliper;
import brakesystem.BrakeDisk;
import brakesystem.BrakeHose;
import brakesystem.BrakePad;


import "http://www.example.org/brakesystem" as brakesystem
import "http://demonstrator.kit.edu/cad" as cad

// A brake component is a part of the CAD document, i.e. an Assembly named by the id of the
// component (see CadUtility). The pads of a caliper are nested in the caliper's assembly.
// Only dimensions are part of the overlap: each length attribute is a named constraint of the
// part, in metres. Texts, flags and counts have no counterpart in CAD.

reactions: brakesystem2cad
in reaction to changes in brakesystem
execute actions in cad

reaction BrakesystemInsertedAsRoot {
    after element brakesystem::Brakesystem inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(brakesystem::Brakesystem repo) {
    match {
        require absence of cad::CADDocument corresponding to repo
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, repo, CADDocument)
        if (existing !== null) {
            addCorrespondenceBetween(repo, existing)
        } else {
            createRoot(repo)
        }
    }
}

routine createRoot(brakesystem::Brakesystem repo) {
    match {
        require absence of cad::CADDocument corresponding to repo
    }
    create {
        val mCad = new cad::CADDocument
    }
    update {
        persistProjectRelative(repo, mCad, "example.cad")
        addCorrespondenceBetween(repo, mCad)
    }
}

reaction BrakesystemDeleted {
    after element brakesystem::Brakesystem deleted
    call deleteCorrespondingCADDocument(affectedEObject)
}

routine deleteCorrespondingCADDocument(brakesystem::Brakesystem repo) {
    match {
        val mCad = retrieve cad::CADDocument corresponding to repo
    }
    update {
        removeObject(mCad)
        removeCorrespondenceBetween(repo, mCad)
    }
}

//
//// Brake Component
//
reaction BrakeComponentInserted {
    after element brakesystem::BrakeComponent inserted in brakesystem::Brakesystem[brakeComponents]
    call createOrPlacePart(newValue)
}

reaction BrakePadInsertedInCaliper {
    after element brakesystem::BrakePad inserted in brakesystem::BrakeCaliper[brakePads]
    call createOrPlacePart(newValue)
}

// A component that already has a part was moved (e.g. a pad into another caliper): the part follows
routine createOrPlacePart(brakesystem::BrakeComponent component) {
    update {
        val part = getCorrespondingElements(component, Assembly, null, null).head
        if (part === null) {
            createAndRegisterBrakeComponent(component)
        } else {
            placePart(component, part)
        }
    }
}

routine createAndRegisterBrakeComponent(brakesystem::BrakeComponent component) {
    match {
        require absence of cad::Assembly corresponding to component
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, component, Assembly)
        if (existing !== null) {
            addCorrespondenceBetween(component, existing)
            placePart(component, existing)
        } else {
            createPart(component)
        }
    }
}

routine createPart(brakesystem::BrakeComponent component) {
    update {
        val part = CadUtility.createPart(component.id, component.id)
        placePart(component, part)
        addCorrespondenceBetween(component, part)
        updateDimensions(component)
    }
}

// The part of a pad is nested in the part of its caliper, if the caliper has one
routine placePart(brakesystem::BrakeComponent component, cad::Assembly part) {
    update {
        val container = component.eContainer
        val system = if (container instanceof BrakeCaliper) container.eContainer else container
        val document = getCorrespondingElements(system, CADDocument, null, null).head
        if (document === null) {
            return
        }
        val parent = if (container instanceof BrakeCaliper) getCorrespondingElements(container, Assembly, null, null).head
        CadUtility.placePart(part, parent, document)
    }
}

reaction IdChanged {
    after attribute replaced at brakesystem::BrakeComponent[id]
    call updateId(affectedEObject)
}

routine updateId(brakesystem::BrakeComponent comp) {
    match {
        val part = retrieve cad::Assembly corresponding to comp
    }
    update {
        CadUtility.renamePart(part, comp.id)
    }
}

/// Deletion
/// Generalized to _any_ BrakeComponent

reaction BrakeComponentDeleted {
    after element brakesystem::BrakeComponent deleted
    call deleteCorrespondingPart(affectedEObject)
}

routine deleteCorrespondingPart(brakesystem::BrakeComponent component) {
    match {
        val part = retrieve cad::Assembly corresponding to component
    }
    update {
        removeObject(part)
        removeCorrespondenceBetween(component, part)
    }
}

//
//// Dimensions
//
// Every length attribute (in whole millimetres) is the named constraint of the same name in the
// part. Values are only written if the constraint does not already represent them.

routine updateDimensions(brakesystem::BrakeComponent component) {
    update {
        switch (component) {
            ABSSensor: {
                updateLengthIfSet(component, "Fitting Depth", "fittingDepth", component.fittingDepth)
                updateLengthIfSet(component, "Length", "lengthInMM", component.lengthInMM)
            }
            BrakeCaliper: {
                updateLengthIfSet(component, "Piston Diameter", "pistonDiameterInMM", component.pistonDiameterInMM)
                updateLengthIfSet(component, "Brake Disk Thickness", "brakeDiskThickness", component.brakeDiskThickness)
            }
            BrakeHose:
                updateLengthIfSet(component, "Length", "lengthInMM", component.lengthInMM)
            BrakeDisk: {
                updateLengthIfSet(component, "Diameter", "diameterInMM", component.diameterInMM)
                updateLengthIfSet(component, "Centering Diameter", "centeringDiameterInMM", component.centeringDiameterInMM)
                updateLengthIfSet(component, "Bolt Hole Circle", "boltHoleCircleInMM", component.boltHoleCircleInMM)
                updateLengthIfSet(component, "Brake Disk Thickness", "brakeDiskThicknessInMM", component.brakeDiskThicknessInMM)
                updateLengthIfSet(component, "Minimum Thickness", "minimumThicknessInMM", component.minimumThicknessInMM)
            }
            BrakePad: {
                updateLengthIfSet(component, "Height", "heightInMM", component.heightInMM)
                updateLengthIfSet(component, "Width", "widthInMM", component.widthInMM)
                updateLengthIfSet(component, "Thickness", "thicknessInMM", component.thicknessInMM)
            }
        }
    }
}

// Attributes that were never set get no constraint, so defaults do not show up as dimensions
routine updateLengthIfSet(brakesystem::BrakeComponent component, String name, String featureName, Integer millimetres) {
    update {
        if (component.eIsSet(component.eClass.getEStructuralFeature(featureName))) {
            updateLength(component, name, millimetres)
        }
    }
}

routine updateLength(brakesystem::BrakeComponent component, String name, Integer millimetres) {
    match {
        val part = retrieve cad::Assembly corresponding to component
    }
    update {
        CadUtility.putLength(part, name, millimetres.intValue)
    }
}

// Brake Disk

reaction DiameterChanged {
    after attribute replaced at brakesystem::BrakeDisk[diameterInMM]
    call updateLength(affectedEObject, "Diameter", newValue)
}

reaction CenteringDiameterChanged {
    after attribute replaced at brakesystem::BrakeDisk[centeringDiameterInMM]
    call updateLength(affectedEObject, "Centering Diameter", newValue)
}

reaction BoltHoleCircleChanged {
    after attribute replaced at brakesystem::BrakeDisk[boltHoleCircleInMM]
    call updateLength(affectedEObject, "Bolt Hole Circle", newValue)
}

reaction BrakeDiskThicknessChanged {
    after attribute replaced at brakesystem::BrakeDisk[brakeDiskThicknessInMM]
    call updateLength(affectedEObject, "Brake Disk Thickness", newValue)
}

reaction MinimumThicknessChanged {
    after attribute replaced at brakesystem::BrakeDisk[minimumThicknessInMM]
    call updateLength(affectedEObject, "Minimum Thickness", newValue)
}

// Brake Caliper

reaction PistonDiameterChanged {
    after attribute replaced at brakesystem::BrakeCaliper[pistonDiameterInMM]
    call updateLength(affectedEObject, "Piston Diameter", newValue)
}

reaction BrakeDiskThicknessChangedCaliper {
    after attribute replaced at brakesystem::BrakeCaliper[brakeDiskThickness]
    call updateLength(affectedEObject, "Brake Disk Thickness", newValue)
}

// Brake Pad

reaction HeightChanged {
    after attribute replaced at brakesystem::BrakePad[heightInMM]
    call updateLength(affectedEObject, "Height", newValue)
}

reaction WidthChanged {
    after attribute replaced at brakesystem::BrakePad[widthInMM]
    call updateLength(affectedEObject, "Width", newValue)
}

reaction ThicknessChanged {
    after attribute replaced at brakesystem::BrakePad[thicknessInMM]
    call updateLength(affectedEObject, "Thickness", newValue)
}

// Brake Hose

reaction LengthChangedHose {
    after attribute replaced at brakesystem::BrakeHose[lengthInMM]
    call updateLength(affectedEObject, "Length", newValue)
}

// ABS Sensor

reaction FittingDepthChanged {
    after attribute replaced at brakesystem::ABSSensor[fittingDepth]
    call updateLength(affectedEObject, "Fitting Depth", newValue)
}

reaction LengthChanged {
    after attribute replaced at brakesystem::ABSSensor[lengthInMM]
    call updateLength(affectedEObject, "Length", newValue)
}
