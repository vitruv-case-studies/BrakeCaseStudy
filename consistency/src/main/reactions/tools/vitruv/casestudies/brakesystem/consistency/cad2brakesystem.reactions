import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality
import java.util.Arrays

import edu.kit.ipd.sdq.metamodels.cad.StringParameter;
import edu.kit.ipd.sdq.metamodels.cad.NumericParameter;
import edu.kit.ipd.sdq.metamodels.cad.BooleanParameter;

import tools.vitruv.casestudies.brakesystem.consistency.ParameterValueUtility;

import brakesystem.ABSSensor;
import brakesystem.BrakeCaliper;
import brakesystem.BrakeHose;
import brakesystem.BrakeDisk;
import brakesystem.BrakePad;
import brakesystem.Brakesystem;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import brakesystem.BrakeComponent;
import simulink.Block;
import autosar.SensorActuatorSwComponentType;
import bom.Item;
import tools.vitruv.casestudies.brakesystem.consistency.BomUtility;

import "http://www.example.org/brakesystem" as brakesystem
import "http://www.example.org/cad" as cad

reactions: cad2brakesystem
in reaction to changes in cad
execute actions in brakesystem

reaction CAD_ModelInsertedAsRoot {
    after element cad::CAD_Model inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(cad::CAD_Model model) {
    match {
        require absence of brakesystem::Brakesystem corresponding to model
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, model, Brakesystem)
        if (existing !== null) {
            addCorrespondenceBetween(model, existing)
        } else {
            createRoot(model)
        }
    }
}

routine createRoot(cad::CAD_Model model) {
    match {
        require absence of brakesystem::Brakesystem corresponding to model
    }
    create {
        val mBrake = new brakesystem::Brakesystem
    }
    update {
        persistProjectRelative(model, mBrake, "example.brakesystem")
        addCorrespondenceBetween(model, mBrake)
    }
}

reaction CAD_ModelDeleted {
    after element cad::CAD_Model deleted
    call deleteCorrespondingBrake(affectedEObject)
}

routine deleteCorrespondingBrake(cad::CAD_Model model) {
    match {
        val mBrake = retrieve brakesystem::Brakesystem corresponding to model
    }
    update {
        removeObject(mBrake)
        removeCorrespondenceBetween(model, mBrake)
    }
}

reaction NameSpaceInserted {
    after element cad::Namespace inserted in cad::CAD_Model[namespaces]
    call createAndRegisterNamespace(newValue)
}

routine createAndRegisterNamespace(cad::Namespace namespace) {
    match {
        val mBrake = retrieve brakesystem::Brakesystem corresponding to namespace.eContainer()
        require absence of brakesystem::BrakeComponent corresponding to namespace
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, namespace, BrakeComponent)
        if (existing !== null) {
            addCorrespondenceBetween(namespace, existing)
        } else {
            createAndRegisterNamespaceDirectly(namespace)
        }
    }
}

routine createAndRegisterNamespaceDirectly(cad::Namespace namespace) {
    match {
        val mBrake = retrieve brakesystem::Brakesystem corresponding to namespace.eContainer()
        require absence of brakesystem::BrakeComponent corresponding to namespace
    }
    update {
        // If the namespace already has a Simulink block, simulink2brakesystem decides about the brake component,
        // so the user is asked only once
        if (TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, namespace, Block) !== null) {
            return
        }
        // The BOM already decides whether the part is a brake component (e.g. a bolt is none)
        val item = TransitiveCorrespondenceUtility.findSharedTransitivelyCorresponding(executionState.correspondenceModel, namespace, Item)
        if (BomUtility.isNoBrakeComponent(item)) {
            return
        }
        // AUTOSAR already decides whether the namespace is a sensor
        if (TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, namespace, SensorActuatorSwComponentType) !== null) {
            createABSSensor(namespace, mBrake)
            return
        }
        // Namespaces may also describe physical parts that are no brake components
        val componentType = userInteractor.singleSelectionDialogBuilder.message(
            "What brake component does this namespace '" + namespace.id + "' represent?").choices(
            Arrays.asList("ABSSensor","BrakeCaliper","BrakeHose","BrakeDisk", "BrakePad", "None")).windowModality(WindowModality.MODAL).startInteraction
        switch (componentType) {
            case 0:
                createABSSensor(namespace, mBrake)
            case 1:
                createBrakeCaliper(namespace, mBrake)
            case 2:
                createBrakeHose(namespace, mBrake)
            case 3:
                createBrakeDisk(namespace, mBrake)
            case 4:
                createBrakePad(namespace, mBrake)
            default:
                return // do nothing
        }

    }
}

routine createABSSensor(cad::Namespace namespace, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::ABSSensor
    }
    update {
        component.id = namespace.id
        addCorrespondenceBetween(namespace, component);
        // we cannot use the brakeComponents syntax because there is no setter I think, so we
        // have to use the explicit getter syntax
        mBrake.getBrakeComponents.add(component);
    }
}

routine createBrakeCaliper(cad::Namespace namespace, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::BrakeCaliper
    }
    update {
        component.id = namespace.id
        addCorrespondenceBetween(namespace, component);
        mBrake.getBrakeComponents.add(component);
    }
}

routine createBrakeHose(cad::Namespace namespace, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::BrakeHose
    }
    update {
        component.id = namespace.id
        addCorrespondenceBetween(namespace, component);
        mBrake.getBrakeComponents.add(component);
    }
}

routine createBrakeDisk(cad::Namespace namespace, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::BrakeDisk
    }
    update {
        component.id = namespace.id
        addCorrespondenceBetween(namespace, component);
        mBrake.getBrakeComponents.add(component);
    }
}

routine createBrakePad(cad::Namespace namespace, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::BrakePad
    }
    update {
        val calipers = mBrake.getBrakeComponents.filter[it instanceof BrakeCaliper].map[it as BrakeCaliper].toList
        var chosen = 0
        if (calipers.size() > 0) {
            val choices = calipers.map[id] + #["None"]
            chosen = userInteractor.singleSelectionDialogBuilder.message(
                "Which brake calipher does this brake pad belong to?").choices(choices).windowModality(WindowModality.MODAL).
                startInteraction
        }

        if (chosen < 0 || chosen > calipers.size) {
            return
        }

        component.id = namespace.id
        addCorrespondenceBetween(namespace, component);

        if (chosen < calipers.size) {
            val chosenCaliper = calipers.get(chosen)
            chosenCaliper.brakePads.add(component)
        } else {
            mBrake.getBrakeComponents.add(component);
        }
    }
}

// Reaction for changing the id of namespace
reaction NamespaceIdChanged {
    after attribute replaced at cad::Namespace[id]
    call updateCorrespondingBrakeComponentId(affectedEObject)   
}


routine updateCorrespondingBrakeComponentId(cad::Namespace namespace) {
    match {
        // Retrieve the corresponding BrakeComponent 
        val component = retrieve brakesystem::BrakeComponent corresponding to namespace
    }
    update {
        // Propagate ID change
        component.id = namespace.id
    }
}

// Deletion of Namespaces
reaction NamespaceDeleted {
    after element cad::Namespace deleted
    call deleteCorrespondingBrakeComponent(affectedEObject)
}

routine deleteCorrespondingBrakeComponent(cad::Namespace namespace) {
    match {
        // Retrieve the corresponding BrakeComponent
        val component = retrieve brakesystem::BrakeComponent corresponding to namespace
    }
    update {
        removeObject(component)
        removeCorrespondenceBetween(component, namespace)
    }
}

// TODO: maybe avoid if this reaction is called by propagation of the attribute change (only for efficiency)
reaction ParameterInserted {
    after element cad::Parameter inserted in cad::Namespace[parameters]
    call updateCorrespondingAttribute(newValue)
}

reaction StringParameterValueChanged {
    after attribute replaced at cad::StringParameter[value]
    call updateCorrespondingAttribute(affectedEObject)
}

reaction NumericParameterValueChanged {
    after attribute replaced at cad::NumericParameter[value]
    call updateCorrespondingAttribute(affectedEObject)
}

reaction NumericParameterUnitChanged {
    after attribute replaced at cad::NumericParameter[unit]
    call updateCorrespondingAttribute(affectedEObject)
}

reaction BooleanParameterValueChanged {
    after attribute replaced at cad::BooleanParameter[value]
    call updateCorrespondingAttribute(affectedEObject)
}

routine updateCorrespondingAttribute(cad::Parameter parameter) {
    match {
        val mBrakeComponent = retrieve brakesystem::BrakeComponent corresponding to parameter.eContainer()
    }
    update {
        val name = parameter.name
        if (name == "Specification Type" || name == "OEM Number" || name == "Fitting Position") {
            updateBrakeComponent(parameter)
            return
        } 

        if (mBrakeComponent instanceof ABSSensor) {
            updateABSSensor(parameter)
        } else if (mBrakeComponent instanceof BrakeCaliper) {
            updateBrakeCaliper(parameter)
        } else if (mBrakeComponent instanceof BrakeHose) {
            updateBrakeHose(parameter)
        } else if (mBrakeComponent instanceof BrakeDisk) {
            updateBrakeDisk(parameter)
        } else if (mBrakeComponent instanceof BrakePad) {
            updateBrakePad(parameter)
        }
    }
}

routine updateBrakeComponent(cad::Parameter parameter) {
    match {
        val mBrakeComponent = retrieve brakesystem::BrakeComponent corresponding to parameter.eContainer()
    }
    update {
        if (!(parameter instanceof StringParameter)) {
            return
        }
        val stringParam = parameter as StringParameter
        switch (parameter.name) {
            case "Specification Type":
                mBrakeComponent.setSpecificationType(stringParam.value)
            case "OEM Number":
                mBrakeComponent.setOEM_number(stringParam.value)
            case "Fitting Position":
                mBrakeComponent.setFittingPosition(stringParam.value)
            default:
                return // Do nothing for unhandled parameters
        }
    }
}

// Numeric CAD parameters carry a unit, while the brake system stores whole millimetres or counts.
// Lengths are converted to millimetres; a length given with unit COUNT is ignored.
// Counts are dimensionless, so their unit is ignored (an unset CAD unit defaults to MM).

routine updateABSSensor(cad::Parameter parameter) {
    match {
        val absSensor = retrieve brakesystem::ABSSensor corresponding to parameter.eContainer()
    }
    update {
        if (parameter instanceof StringParameter) {
            if (parameter.name == "Sensor Type") {
                absSensor.setSensorType(parameter.value)
            }
            return
        }
        if (parameter instanceof NumericParameter) {
            val millimetres = ParameterValueUtility.toMillimetres(parameter.value, parameter.unit)
            switch (parameter.name) {
                case "Fitting Depth":
                    if (millimetres !== null) absSensor.setFittingDepth(millimetres)
                case "Length":
                    if (millimetres !== null) absSensor.setLengthInMM(millimetres)
                case "Number of Pins":
                    absSensor.setNumberOfPins(Math.round(parameter.value))
            }
        }
    }
}

routine updateBrakeCaliper(cad::Parameter parameter) {
    match {
        val brakeCaliper = retrieve brakesystem::BrakeCaliper corresponding to parameter.eContainer()
    }
    update {
        if (parameter instanceof NumericParameter) {
            val millimetres = ParameterValueUtility.toMillimetres(parameter.value, parameter.unit)
            if (millimetres === null) {
                return
            }
            switch (parameter.name) {
                case "Piston Diameter":
                    brakeCaliper.setPistonDiameterInMM(millimetres)
                case "Brake Disk Thickness":
                    brakeCaliper.setBrakeDiskThickness(millimetres)
            }
        }
    }
}

routine updateBrakeHose(cad::Parameter parameter) {
    match {
        val brakeHose = retrieve brakesystem::BrakeHose corresponding to parameter.eContainer()
    }
    update {
        if (parameter instanceof StringParameter) {
            switch (parameter.name) {
                case "Thread 1":
                    brakeHose.setThreadSize1(parameter.value)
                case "Thread 2":
                    brakeHose.setThreadSize2(parameter.value)
            }
            return
        }
        if (parameter instanceof NumericParameter) {
            val millimetres = ParameterValueUtility.toMillimetres(parameter.value, parameter.unit)
            if (parameter.name == "Length" && millimetres !== null) {
                brakeHose.setLengthInMM(millimetres)
            }
        }
    }
}

routine updateBrakeDisk(cad::Parameter parameter) {
    match {
        val brakeDisk = retrieve brakesystem::BrakeDisk corresponding to parameter.eContainer()
    }
    update {
        if (parameter instanceof NumericParameter) {
            if (parameter.name == "Rim Hole Number") {
                brakeDisk.setRimHoleNumber(Math.round(parameter.value))
                return
            }
            if (parameter.name == "Hole Arrangement Number") {
                brakeDisk.setHoleArrangementNumber(Math.round(parameter.value))
                return
            }
            val millimetres = ParameterValueUtility.toMillimetres(parameter.value, parameter.unit)
            if (millimetres === null) {
                return
            }
            switch (parameter.name) {
                case "Diameter":
                    brakeDisk.setDiameterInMM(millimetres)
                case "Centering Diameter":
                    brakeDisk.setCenteringDiameterInMM(millimetres)
                case "Bolt Hole Circle":
                    brakeDisk.setBoltHoleCircleInMM(millimetres)
                case "Brake Disk Thickness":
                    brakeDisk.setBrakeDiskThicknessInMM(millimetres)
                case "Minimum Thickness":
                    brakeDisk.setMinimumThicknessInMM(millimetres)
            }
            return
        }
        if (parameter instanceof BooleanParameter) {
            if (parameter.name == "Ventilated") {
                brakeDisk.setVentilated(parameter.value)
            }
        }
    }
}

routine updateBrakePad(cad::Parameter parameter) {
    match {
        val brakePad = retrieve brakesystem::BrakePad corresponding to parameter.eContainer()
    }
    update {
        if (parameter instanceof NumericParameter) {
            val millimetres = ParameterValueUtility.toMillimetres(parameter.value, parameter.unit)
            if (millimetres === null) {
                return
            }
            switch (parameter.name) {
                case "Height":
                    brakePad.setHeightInMM(millimetres)
                case "Width":
                    brakePad.setWidthInMM(millimetres)
                case "Thickness":
                    brakePad.setThicknessInMM(millimetres)
            }
            return
        }
        if (parameter instanceof BooleanParameter) {
            if (parameter.name == "Wear Warning") {
                brakePad.setWearWarning(parameter.value)
            }
        }
    }
}
