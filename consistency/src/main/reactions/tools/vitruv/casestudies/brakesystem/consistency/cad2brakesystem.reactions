import tools.vitruv.change.interaction.UserInteractionOptions.WindowModality
import java.util.Arrays

import edu.kit.ipd.sdq.metamodels.cad.Assembly;

import tools.vitruv.casestudies.brakesystem.consistency.CadUtility;

import brakesystem.ABSSensor;
import brakesystem.BrakeCaliper;
import brakesystem.BrakeHose;
import brakesystem.BrakeDisk;
import brakesystem.BrakePad;
import brakesystem.Brakesystem;
import tools.vitruv.casestudies.brakesystem.consistency.TransitiveCorrespondenceUtility;
import brakesystem.BrakeComponent;
import simulink.Block;
import autosar.SensorActuatorSwComponentType;
import bom.Item;
import tools.vitruv.casestudies.brakesystem.consistency.BomUtility;

import "http://www.example.org/brakesystem" as brakesystem
import "http://demonstrator.kit.edu/cad" as cad

// A brake component is a part of the CAD document, i.e. an Assembly (see CadUtility). Its id is the
// name of the assembly. Brake pads of a caliper are assemblies nested in the caliper's assembly.
// Only the dimensions of the brake components are part of the overlap: they are named constraints
// of the part's sketches, in metres. Texts, flags and counts have no counterpart in CAD.

reactions: cad2brakesystem
in reaction to changes in cad
execute actions in brakesystem

reaction CADDocumentInsertedAsRoot {
    after element cad::CADDocument inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(cad::CADDocument document) {
    match {
        require absence of brakesystem::Brakesystem corresponding to document
    }
    update {
        // Another model may already have created the counterpart; reuse it instead of creating a second root
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, document, Brakesystem)
        if (existing !== null) {
            addCorrespondenceBetween(document, existing)
        } else {
            createRoot(document)
        }
    }
}

routine createRoot(cad::CADDocument document) {
    match {
        require absence of brakesystem::Brakesystem corresponding to document
    }
    create {
        val mBrake = new brakesystem::Brakesystem
    }
    update {
        persistProjectRelative(document, mBrake, "example.brakesystem")
        addCorrespondenceBetween(document, mBrake)
    }
}

reaction CADDocumentDeleted {
    after element cad::CADDocument deleted
    call deleteCorrespondingBrake(affectedEObject)
}

routine deleteCorrespondingBrake(cad::CADDocument document) {
    match {
        val mBrake = retrieve brakesystem::Brakesystem corresponding to document
    }
    update {
        removeObject(mBrake)
        removeCorrespondenceBetween(document, mBrake)
    }
}

//
//// Parts
//

reaction PartInsertedInDocument {
    after element cad::Assembly inserted in cad::CADDocument[objects]
    call createOrPlaceBrakeComponent(newValue)
}

reaction PartInsertedInPart {
    after element cad::Assembly inserted in cad::Assembly[children]
    call createOrPlaceBrakeComponent(newValue)
}

// A part that already has a brake component was moved: a brake pad follows into the caliper of
// its new parent part, or to the top level of the brake system
routine createOrPlaceBrakeComponent(cad::Assembly part) {
    update {
        val component = getCorrespondingElements(part, BrakeComponent, null, null).head
        if (component === null) {
            createAndRegisterPart(part)
        } else if (component instanceof BrakePad) {
            placeBrakePad(part, component)
        }
    }
}

routine placeBrakePad(cad::Assembly part, brakesystem::BrakePad pad) {
    match {
        val mBrake = retrieve brakesystem::Brakesystem corresponding to CadUtility.documentOf(part)
    }
    update {
        val parent = CadUtility.parentPart(part)
        val caliper = if (parent !== null) getCorrespondingElements(parent, BrakeCaliper, null, null).head
        if (caliper !== null) {
            if (pad.eContainer !== caliper) caliper.brakePads.add(pad)
        } else if (pad.eContainer !== mBrake) {
            mBrake.getBrakeComponents.add(pad)
        }
    }
}

routine createAndRegisterPart(cad::Assembly part) {
    match {
        val mBrake = retrieve brakesystem::Brakesystem corresponding to CadUtility.documentOf(part)
        require absence of brakesystem::BrakeComponent corresponding to part
    }
    update {
        // The counterpart may already exist via another model; then only the missing correspondence is added
        val existing = TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, part, BrakeComponent)
        if (existing !== null) {
            addCorrespondenceBetween(part, existing)
        } else {
            createAndRegisterPartDirectly(part)
        }
        // Parameters may have been added together with the part
        for (parameter : CadUtility.parameters(part)) updateCorrespondingAttribute(parameter)
    }
}

routine createAndRegisterPartDirectly(cad::Assembly part) {
    match {
        val mBrake = retrieve brakesystem::Brakesystem corresponding to CadUtility.documentOf(part)
        require absence of brakesystem::BrakeComponent corresponding to part
    }
    update {
        // If the part already has a Simulink block, simulink2brakesystem decides about the brake component,
        // so the user is asked only once
        if (TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, part, Block) !== null) {
            return
        }
        // The BOM already decides whether the part is a brake component (e.g. a bolt is none)
        val item = TransitiveCorrespondenceUtility.findSharedTransitivelyCorresponding(executionState.correspondenceModel, part, Item)
        if (BomUtility.isNoBrakeComponent(item)) {
            return
        }
        // AUTOSAR already decides whether the part is a sensor
        if (TransitiveCorrespondenceUtility.findTransitivelyCorresponding(executionState.correspondenceModel, part, SensorActuatorSwComponentType) !== null) {
            createABSSensor(part, mBrake)
            return
        }
        // Parts may also be physical parts that are no brake components
        val componentType = userInteractor.singleSelectionDialogBuilder.message(
            "What brake component does this part '" + part.name + "' represent?").choices(
            Arrays.asList("ABSSensor","BrakeCaliper","BrakeHose","BrakeDisk", "BrakePad", "None")).windowModality(WindowModality.MODAL).startInteraction
        switch (componentType) {
            case 0:
                createABSSensor(part, mBrake)
            case 1:
                createBrakeCaliper(part, mBrake)
            case 2:
                createBrakeHose(part, mBrake)
            case 3:
                createBrakeDisk(part, mBrake)
            case 4:
                createBrakePad(part, mBrake)
            default:
                return // do nothing
        }

    }
}

routine createABSSensor(cad::Assembly part, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::ABSSensor
    }
    update {
        component.id = part.name
        addCorrespondenceBetween(part, component);
        // we cannot use the brakeComponents syntax because there is no setter I think, so we
        // have to use the explicit getter syntax
        mBrake.getBrakeComponents.add(component);
    }
}

routine createBrakeCaliper(cad::Assembly part, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::BrakeCaliper
    }
    update {
        component.id = part.name
        addCorrespondenceBetween(part, component);
        mBrake.getBrakeComponents.add(component);
    }
}

routine createBrakeHose(cad::Assembly part, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::BrakeHose
    }
    update {
        component.id = part.name
        addCorrespondenceBetween(part, component);
        mBrake.getBrakeComponents.add(component);
    }
}

routine createBrakeDisk(cad::Assembly part, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::BrakeDisk
    }
    update {
        component.id = part.name
        addCorrespondenceBetween(part, component);
        mBrake.getBrakeComponents.add(component);
    }
}

// A pad nested in the part of a caliper belongs to that caliper; otherwise the user chooses the caliper
routine createBrakePad(cad::Assembly part, brakesystem::Brakesystem mBrake) {
    create {
        val component = new brakesystem::BrakePad
    }
    update {
        val parent = CadUtility.parentPart(part)
        var BrakeCaliper chosenCaliper = if (parent !== null) getCorrespondingElements(parent, BrakeCaliper, null, null).head
        if (chosenCaliper === null) {
            val calipers = mBrake.getBrakeComponents.filter[it instanceof BrakeCaliper].map[it as BrakeCaliper].toList
            var chosen = 0
            if (calipers.size() > 0) {
                val choices = calipers.map[id] + #["None"]
                chosen = userInteractor.singleSelectionDialogBuilder.message(
                    "Which brake calipher does this brake pad belong to?").choices(choices).windowModality(WindowModality.MODAL).
                    startInteraction
            }
            if (chosen < 0 || chosen > calipers.size) {
                return
            }
            if (chosen < calipers.size) {
                chosenCaliper = calipers.get(chosen)
            }
        }

        component.id = part.name
        addCorrespondenceBetween(part, component);

        if (chosenCaliper !== null) {
            chosenCaliper.brakePads.add(component)
        } else {
            mBrake.getBrakeComponents.add(component);
        }
    }
}

// The name of a part is its stable identifier, like the id of the brake component
reaction PartNameChanged {
    after attribute replaced at cad::Assembly[name]
    call updateCorrespondingBrakeComponentId(affectedEObject)
}

routine updateCorrespondingBrakeComponentId(cad::Assembly part) {
    match {
        val component = retrieve brakesystem::BrakeComponent corresponding to part
    }
    update {
        if (component.id != part.name) component.id = part.name
    }
}

reaction PartDeleted {
    after element cad::Assembly deleted
    call deleteCorrespondingBrakeComponent(affectedEObject)
}

routine deleteCorrespondingBrakeComponent(cad::Assembly part) {
    match {
        val component = retrieve brakesystem::BrakeComponent corresponding to part
    }
    update {
        removeObject(component)
        removeCorrespondenceBetween(component, part)
    }
}

//
//// Parameters (named dimensional constraints, see CadUtility)
//

reaction ParameterInserted {
    after element cad::Constraint inserted in cad::Sketch[constraints]
    call updateCorrespondingAttribute(newValue)
}

reaction ParameterSketchInserted {
    after element cad::Sketch inserted in cad::Assembly[children]
    call updateCorrespondingAttributes(newValue)
}

routine updateCorrespondingAttributes(cad::Sketch sketch) {
    update {
        for (constraint : sketch.constraints) updateCorrespondingAttribute(constraint)
    }
}

reaction ParameterValueChanged {
    after attribute replaced at cad::Constraint[value]
    call updateCorrespondingAttribute(affectedEObject)
}

reaction ParameterNameChanged {
    after attribute replaced at cad::Constraint[name]
    call updateCorrespondingAttribute(affectedEObject)
}

reaction ParameterTypeChanged {
    after attribute replaced at cad::Constraint[type]
    call updateCorrespondingAttribute(affectedEObject)
}

// The brake system stores whole millimetres; angles are no lengths and are ignored
routine updateCorrespondingAttribute(cad::Constraint parameter) {
    update {
        if (!CadUtility.isParameter(parameter)) {
            return
        }
        val millimetres = CadUtility.lengthInMillimetres(parameter)
        if (millimetres === null) {
            return
        }
        updateBrakeComponent(CadUtility.partOf(parameter), parameter.name, millimetres)
    }
}

routine updateBrakeComponent(cad::Assembly part, String name, Integer millimetres) {
    match {
        val component = retrieve brakesystem::BrakeComponent corresponding to part
    }
    update {
        val mm = millimetres.intValue
        switch (component) {
            ABSSensor: switch (name) {
                case "Fitting Depth": if (component.fittingDepth != mm) component.setFittingDepth(mm)
                case "Length": if (component.lengthInMM != mm) component.setLengthInMM(mm)
            }
            BrakeCaliper: switch (name) {
                case "Piston Diameter": if (component.pistonDiameterInMM != mm) component.setPistonDiameterInMM(mm)
                case "Brake Disk Thickness": if (component.brakeDiskThickness != mm) component.setBrakeDiskThickness(mm)
            }
            BrakeHose: switch (name) {
                case "Length": if (component.lengthInMM != mm) component.setLengthInMM(mm)
            }
            BrakeDisk: switch (name) {
                case "Diameter": if (component.diameterInMM != mm) component.setDiameterInMM(mm)
                case "Centering Diameter": if (component.centeringDiameterInMM != mm) component.setCenteringDiameterInMM(mm)
                case "Bolt Hole Circle": if (component.boltHoleCircleInMM != mm) component.setBoltHoleCircleInMM(mm)
                case "Brake Disk Thickness": if (component.brakeDiskThicknessInMM != mm) component.setBrakeDiskThicknessInMM(mm)
                case "Minimum Thickness": if (component.minimumThicknessInMM != mm) component.setMinimumThicknessInMM(mm)
            }
            BrakePad: switch (name) {
                case "Height": if (component.heightInMM != mm) component.setHeightInMM(mm)
                case "Width": if (component.widthInMM != mm) component.setWidthInMM(mm)
                case "Thickness": if (component.thicknessInMM != mm) component.setThicknessInMM(mm)
            }
        }
    }
}
