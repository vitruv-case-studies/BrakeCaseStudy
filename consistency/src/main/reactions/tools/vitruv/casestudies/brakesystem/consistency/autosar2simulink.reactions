import java.io.File;

import autosar.CompositionSwComponentType;

import "http://www.example.org/simulink" as simulink
import "http://www.example.org/autosar" as autosar

reactions: autosar2simulink
in reaction to changes in autosar
execute actions in simulink

// Root Reactions
reaction AutoSarModelInsertedAsRoot {
    after element autosar::AUTOSAR inserted as root
    call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(autosar::AUTOSAR model) {
    match {
        require absence of simulink::SimulinkModel corresponding to model
    }
    create {
        val mSimulink = new simulink::SimulinkModel
    }
    update {
        persistProjectRelative(model, mSimulink, new File("").toString() + "simulink.xml")
        addCorrespondenceBetween(model, mSimulink)
    }
}

reaction AutoSarModelDeletedAsRoot {
    after element autosar::AUTOSAR deleted
    call deleteAndUnregisterRoot(affectedEObject)
}       

routine deleteAndUnregisterRoot(autosar::AUTOSAR model) {
    match {
       val mSimulink = retrieve simulink::SimulinkModel corresponding to model 
    }
    update {
        removeCorrespondenceBetween(model, mSimulink)
        removeObject(mSimulink)
    }
}

// Block Reactions
reaction SwComponentTypeInserted {
    after element autosar::SwComponentType inserted in autosar::ARPackage[elements]
    call createCorrespondingSimulinkElement(newValue)
}

routine createCorrespondingSimulinkElement(autosar::SwComponentType component) {
    match {
        val mSimulinkModel = retrieve simulink::SimulinkModel corresponding to component.eContainer().eContainer()
    }
    update {
        if (component instanceof CompositionSwComponentType) {
            createCorrespondingSubsystem(mSimulinkModel, component)
        } else {
            createCorrespondingBlock(mSimulinkModel, component)
        }
    }
}

routine createCorrespondingSubsystem(simulink::SimulinkModel mSimulinkModel, autosar::CompositionSwComponentType composition) {
    create {
        val mSubsystem = new simulink::SubSystem
    }
    update {
        mSubsystem.name = composition.getShortName()
        mSimulinkModel.getContains().add(mSubsystem)
        addCorrespondenceBetween(composition, mSubsystem)
    }
}

routine createCorrespondingBlock(simulink::SimulinkModel mSimulinkModel, autosar::SwComponentType component) {
    create {
        val mBlock = new simulink::Block
    }
    update {
        mBlock.name = component.getShortName()
        mSimulinkModel.getContains().add(mBlock)
        addCorrespondenceBetween(component, mBlock)
    }
}

reaction SwComponentPrototypeTypeSet {
    after element autosar::SwComponentType replaced at autosar::SwComponentPrototype[type]
    call insertCorrespondingBlock(affectedEObject)
}

routine insertCorrespondingBlock(autosar::SwComponentPrototype prototype) {
    match {
        val mSubsystem = retrieve simulink::SubSystem corresponding to prototype.eContainer()
        val mChildBlock = retrieve simulink::Block corresponding to prototype.type
    }
    update {
        mSubsystem.getSubBlocks().add(mChildBlock)
    }
}

reaction SwComponentPrototypeRemoved {
    after element autosar::SwComponentPrototype removed from autosar::CompositionSwComponentType[components]
    call extractBlock(affectedEObject, oldValue)
}

routine extractBlock(autosar::CompositionSwComponentType parentComposition, autosar::SwComponentPrototype prototype) {
    match {
        val mSubsystem = retrieve simulink::SubSystem corresponding to parentComposition
        val mChildBlock = retrieve simulink::Block corresponding to prototype.type
        val mSimulinkModel = retrieve simulink::SimulinkModel corresponding to parentComposition.eContainer().eContainer()
    }
    update {
        mSubsystem.getSubBlocks().remove(mChildBlock)
        // prototype.type is not containment, so the component still exists in the package and we cannot just delete the corresponding block.
        mSimulinkModel.getContains().add(mChildBlock)
    }
}

reaction SwComponentTypeRemoved {
    after element autosar::SwComponentType removed from autosar::ARPackage[elements]
    call removeCorrespondingSimulinkElement(oldValue)
}

routine removeCorrespondingSimulinkElement(autosar::SwComponentType component) {
    match {
        val mBlock = retrieve simulink::Block corresponding to component
    }
    update {
        removeObject(mBlock)
        removeCorrespondenceBetween(component, mBlock)
    }
}
